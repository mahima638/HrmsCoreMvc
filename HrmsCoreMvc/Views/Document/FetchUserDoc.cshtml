@model IEnumerable<HrmsCoreMvc.Models.AdminDocuments>

@{
    ViewData["Title"] = "My Documents";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>My Documents</h2>

    <a asp-controller="Document"
       asp-action="UserFileUpload"
       class="btn btn-primary">
        Upload Document
    </a>

</div>

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">
            My Uploaded Documents
        </h5>
    </div>

    <div class="card-body">

        <table id="documentTable"
               class="table table-hover">

            <thead>
                <tr>
                    <th>Document ID</th>
                    <th>Document Name</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.ADocId
                        </td>

                        <td>
                            @item.DocName
                        </td>

                        <td>

                            <a asp-controller="Document"
                               asp-action="ViewDocument"
                               asp-route-id="@item.ADocId"
                               class="btn btn-sm btn-primary">
                                View
                            </a>

                            <a asp-controller="Document"
                               asp-action="DownloadDocument"
                               asp-route-id="@item.ADocId"
                               class="btn btn-sm btn-success">
                                Download
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            $('#documentTable').DataTable();
        });
    </script>

}