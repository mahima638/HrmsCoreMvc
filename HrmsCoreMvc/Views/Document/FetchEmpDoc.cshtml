@model IEnumerable<HrmsCoreMvc.Models.AdminDocuments>

@{
    ViewData["Title"] = "Uploaded Document List";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Uploaded Document List</h2>

    <a asp-controller="Document"
       asp-action="AdminFileUpload"
       class="btn btn-primary">
        Upload Document
    </a>

</div>

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">
            Uploaded Document List
        </h5>
    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Document ID</th>
                    <th>Document Name</th>
                    <th>User Email</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.ADocId
                        </td>

                        <td>
                            @item.DocName
                        </td>

                        <td>
                            @item.Email
                        </td>

                        <td>

                            <a asp-controller="Document"
                               asp-action="ViewDocument"
                               asp-route-id="@item.ADocId"
                               class="btn btn-sm btn-primary">
                                View
                            </a>

                            <a asp-controller="Document"
                               asp-action="DownloadDocument"
                               asp-route-id="@item.ADocId"
                               class="btn btn-sm btn-success">
                                Download
                            </a>

                            <a asp-controller="Document"
                               asp-action="DeleteDocument"
                               asp-route-id="@item.ADocId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this document?');">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>