@model HrmsCoreMvc.Models.AdminDocuments

@{
    ViewData["Title"] = "Upload Document";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Upload Document</h2>

</div>

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">
            Upload Document
        </h5>
    </div>

    <div class="card-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Document"
              asp-action="UserFileUpload"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- USER EMAIL -->

            <div class="mb-3">

                <label class="form-label">
                    User Email
                </label>

                <input type="text"
                       value="@ViewBag.UserEmail"
                       class="form-control"
                       readonly />

            </div>


            <!-- DOCUMENT -->

            <div class="mb-3">

                <label class="form-label">
                    Document
                </label>

                <select asp-for="DocName"
                        class="form-select">

                    <option value="">
                        -- Select Document --
                    </option>

                    @foreach (var doc in ViewBag.Documents)
                    {
                        <option value="@doc.AddDocName">
                            @doc.AddDocName
                        </option>
                    }

                </select>

            </div>


            <!-- PDF -->

            <div class="mb-3">

                <label class="form-label">
                    Upload PDF
                </label>

                <input type="file"
                       name="pdfFile"
                       class="form-control"
                       accept=".pdf" />

            </div>


            <button type="submit"
                    class="btn btn-primary">

                Save

            </button>

        </form>

    </div>

</div>