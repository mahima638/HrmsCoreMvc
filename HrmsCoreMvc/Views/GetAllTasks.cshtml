@using HrmsCoreMvc.Models.Projects
@model IEnumerable<HrmsCoreMvc.Models.Projects.Task>

@{
    ViewData["Title"] = "Tasks";
    var tasks = Model?.ToList() ?? new List<HrmsCoreMvc.Models.Projects.Task>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Tasks</h2><p class="text-muted mb-0">Projects > Tasks</p></div><a asp-controller="Task" asp-action="AddTask" class="btn btn-primary">+ Add New Task</a></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (tasks.Any())
    {
        foreach (var projectGroup in tasks.GroupBy(x => x.ProjectId))
        {
            var project = projectGroup.First().Project;
            var projectName = project?.ProjectName ?? "Project";
            var totalTasks = projectGroup.Count();
            var completedTasks = projectGroup.Count(x => x.Status == "Completed");
            var progress = totalTasks > 0 ? (completedTasks * 100) / totalTasks : 0;

            <div class="card mb-4 task-project" data-project="@projectName">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">@projectName</h4><p class="text-muted mb-0">Project Value: @project?.ProjectValue</p></div><div><strong>Total Tasks:</strong> @totalTasks <span class="mx-2">|</span> <strong>Completed:</strong> @completedTasks <span class="mx-2">|</span> <strong>Progress:</strong> @progress%</div></div>

                    <div class="progress mb-3"><div class="progress-bar" style="width:@progress%"></div></div>

                    <div class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><div><strong>Priority:</strong> <button type="button" class="btn btn-sm btn-primary ms-2 priority-btn" onclick="filterPriority('All', this)">All</button> <button type="button" class="btn btn-sm btn-outline-secondary priority-btn" onclick="filterPriority('High', this)">High</button> <button type="button" class="btn btn-sm btn-outline-secondary priority-btn" onclick="filterPriority('Medium', this)">Medium</button> <button type="button" class="btn btn-sm btn-outline-secondary priority-btn" onclick="filterPriority('Low', this)">Low</button></div><div class="d-flex gap-2"><select id="statusFilter" class="form-select" style="width:150px;" onchange="filterStatus(this.value)"><option value="All">All Status</option><option value="Pending">Pending</option><option value="In Progress">In Progress</option><option value="On Hold">On Hold</option><option value="Completed">Completed</option></select><input id="dateFilter" type="date" class="form-control" style="width:160px;" onchange="filterDate(this.value)" /></div></div></div></div>

                    <div class="row g-3">

                        @foreach (var item in projectGroup)
                        {
                            <div class="col-md-6 task-card" data-priority="@item.Priority" data-status="@item.Status" data-due="@item.DueDate?.ToString("yyyy-MM-dd")">
                                <div class="card h-100">
                                    <div class="card-body">

                                        <div class="d-flex justify-content-between align-items-start"><div><h5 class="mb-1">@item.Title</h5><small class="text-muted">Project: @item.Project?.ProjectName</small></div><span class="badge @(item.Priority == "High" ? "bg-danger" : item.Priority == "Medium" ? "bg-warning text-dark" : "bg-success")">@item.Priority</span></div>

                                        <hr />

                                        <p class="mb-3">@item.Description</p>

                                        <div class="mb-3"><strong>Project Value:</strong> @item.Project?.ProjectValue</div>

                                        <div class="progress mb-2"><div class="progress-bar" style="width:@(item.Status == "Completed" ? 100 : item.Status == "In Progress" ? 50 : 0)%"></div></div>

                                        <div class="d-flex justify-content-between"><span><strong>Status:</strong> <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "On Hold" ? "bg-secondary" : item.Status == "In Progress" ? "bg-warning text-dark" : "bg-primary")">@item.Status</span></span><span><strong>Due:</strong> @(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</span></div>

                                        <hr />

                                        <div><a asp-controller="Task" asp-action="UpdateTask" asp-route-taskId="@item.TaskId" class="btn btn-sm btn-primary">Edit</a> <form asp-controller="Task" asp-action="DeleteTask" method="post" class="d-inline"><input type="hidden" name="taskId" value="@item.TaskId" /><button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this task?')">Delete</button></form></div>

                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border text-center">No tasks found.</div>
    }

</div>

<script>

    function filterPriority(priority, button) {
        var tasks = document.querySelectorAll(".task-card");

        tasks.forEach(function (task) {
            if (priority == "All" || task.getAttribute("data-priority") == priority) {
                task.style.display = "";
            } else {
                task.style.display = "none";
            }
        });

        document.querySelectorAll(".priority-btn").forEach(function (btn) {
            btn.classList.remove("btn-primary");
            btn.classList.add("btn-outline-secondary");
        });

        button.classList.remove("btn-outline-secondary");
        button.classList.add("btn-primary");
    }

    function filterStatus(status) {
        var tasks = document.querySelectorAll(".task-card");

        tasks.forEach(function (task) {
            if (status == "All" || task.getAttribute("data-status") == status) {
                task.style.display = "";
            } else {
                task.style.display = "none";
            }
        });
    }

    function filterDate(date) {
        var tasks = document.querySelectorAll(".task-card");

        tasks.forEach(function (task) {
            if (date == "" || task.getAttribute("data-due") == date) {
                task.style.display = "";
            } else {
                task.style.display = "none";
            }
        });
    }

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>