@using HrmsCoreMvc.Models.Projects
@model IEnumerable<TaskBoard>
@{ ViewData["Title"] = "Task Boards"; var boards = Model?.OrderBy(x => x.Duedate).ToList() ?? new List<TaskBoard>(); }
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css" />
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Task Boards</h2><p class="text-secondary mb-0">Organise tasks by board.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#boardModal">+ Add Board</button></div><div class="card shadow-sm"><div class="card-header bg-white py-3"><strong>Task Board List</strong></div><div class="card-body p-3"><div class="table-responsive"><table id="boardsTable" class="table table-hover align-middle w-100"><thead class="table-light"><tr><th>Board</th><th>Project ID</th><th>Due Date</th><th>Progress</th></tr></thead><tbody>@foreach(var item in boards){<tr><td class="fw-semibold">@item.TaskBoardName</td><td>@item.ProjectId</td><td>@item.Duedate.ToString("yyyy-MM-dd")</td><td>@item.Percentage%</td></tr>}</tbody></table></div></div></div></div>
<div class="modal fade" id="boardModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/TaskBoard/AddTaskBoard">@Html.AntiForgeryToken()<input type="hidden" name="TaskBoardId" value="0" /><div class="modal-header"><h5 class="modal-title">Add Task Board</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Board name</label><input class="form-control" name="TaskBoardName" required /></div><div class="mb-3"><label class="form-label">Project ID</label><input class="form-control" name="ProjectId" type="number" min="1" required /></div><div class="mb-3"><label class="form-label">Due date</label><input class="form-control" name="Duedate" type="date" required /></div><div class="mb-3"><label class="form-label">Progress percentage</label><input class="form-control" name="Percentage" type="number" min="0" max="100" step="0.01" value="0" /></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Board</button></div></form></div></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script><script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script><script>new DataTable('#boardsTable',{pageLength:10});</script>
