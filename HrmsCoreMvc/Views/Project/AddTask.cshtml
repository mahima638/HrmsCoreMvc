@using TaskModel = HrmsCoreMvc.Models.Projects.Task
@model TaskModel

@{
    ViewData["Title"] = "Add New Task";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Add New Task</h2><p class="text-muted mb-0">Create a new task.</p></div>
        <a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-outline-secondary">Back to Tasks</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Task" asp-action="AddTask" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-12"><label asp-for="Title" class="form-label">Title</label><input asp-for="Title" class="form-control" placeholder="Enter task title" /></div>

                    <div class="col-md-6"><label asp-for="ProjectId" class="form-label">Select Project</label><select asp-for="ProjectId" class="form-select"><option value="0">Select a Project</option>@foreach (var project in ViewBag.Projects){<option value="@project.ProjectId">@project.ProjectName</option>}</select></div>

                    <div class="col-md-6"><label class="form-label">Team Members</label><select name="selectedTeamMembers" class="form-select" multiple>@foreach (var member in ViewBag.TeamMembers){<option value="@member.UserId">@member.FullName</option>}</select><small class="text-muted">Hold Ctrl and select multiple members.</small></div>

                    <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="">Select</option><option>Pending</option><option>In Progress</option><option>Completed</option></select></div>

                    <div class="col-md-6"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option value="">Select</option><option>High</option><option>Medium</option><option>Low</option></select></div>

                    <div class="col-md-6"><label asp-for="TaskBoardId" class="form-label">Task Board ID</label><input asp-for="TaskBoardId" type="number" class="form-control" /></div>

                    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter task description"></textarea></div>

                    <div class="col-12"><label asp-for="FilePath" class="form-label">Upload Attachment</label><input asp-for="FilePath" class="form-control" placeholder="Enter file path" /></div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Add New Task</button>
                </div>

            </form>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>