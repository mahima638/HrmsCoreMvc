@using TaskModel = HrmsCoreMvc.Models.Projects.Task
@model IEnumerable<TaskModel>

@{
    ViewData["Title"] = "Tasks";
    var tasks = Model.ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Tasks</h2><p class="text-muted mb-0">Manage project tasks.</p></div>
        <a asp-controller="Task" asp-action="AddTask" class="btn btn-primary">+ Add Task</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <strong class="me-2">Priority</strong>
            <button class="btn btn-outline-secondary btn-sm">All</button>
            <button class="btn btn-outline-secondary btn-sm">High</button>
            <button class="btn btn-outline-secondary btn-sm">Medium</button>
            <button class="btn btn-outline-secondary btn-sm">Low</button>
        </div>
    </div>

    <div class="row g-3">

        @foreach (var task in tasks)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">@task.Title</h5>
                            <span class="badge @(task.Status == "Completed" ? "bg-success" : "bg-primary")">@task.Status</span>
                        </div>

                        <p class="text-muted">@task.Description</p>

                        <div class="row mb-3">
                            <div class="col-6"><small class="text-muted">Priority</small><br /><strong>@task.Priority</strong></div>
                            <div class="col-6"><small class="text-muted">Project ID</small><br /><strong>@task.ProjectId</strong></div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <form asp-controller="Task" asp-action="DeleteTask" method="post">
                                <input type="hidden" name="taskId" value="@task.TaskId" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        }

        @if (!tasks.Any())
        {
            <div class="col-12">
                <div class="alert alert-light border text-center">No tasks found.</div>
            </div>
        }

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>