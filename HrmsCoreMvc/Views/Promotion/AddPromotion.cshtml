@using HrmsCoreMvc.Models.Promotion
@model Promotion

@{
    ViewData["Title"] = "Add Promotion";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Promotion</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create"
                          asp-controller="Promotion"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Employee -->
                        <div class="mb-3">

                            <label asp-for="UserId"
                                   class="form-label">
                                Employee
                            </label>

                            <select asp-for="UserId"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Users, "UserId", "FullName"))">

                                <option value="">
                                    -- Select Employee --
                                </option>

                            </select>

                            <span asp-validation-for="UserId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Designation From -->
                        <div class="mb-3">

                            <label asp-for="DesignationFrom"
                                   class="form-label">
                                Designation From
                            </label>

                            <input asp-for="DesignationFrom"
                                   class="form-control"
                                   placeholder="Enter previous designation" />

                            <span asp-validation-for="DesignationFrom"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Designation To -->
                        <div class="mb-3">

                            <label asp-for="DesignationTo"
                                   class="form-label">
                                Designation To
                            </label>

                            <input asp-for="DesignationTo"
                                   class="form-control"
                                   placeholder="Enter new designation" />

                            <span asp-validation-for="DesignationTo"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Promotion Date -->
                        <div class="mb-3">

                            <label asp-for="Date"
                                   class="form-label">
                                Promotion Date
                            </label>

                            <input asp-for="Date"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Date"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-check-circle"></i>
                                Save Promotion

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}