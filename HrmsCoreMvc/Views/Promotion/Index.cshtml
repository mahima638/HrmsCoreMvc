@using HrmsCoreMvc.Models.Promotion
@model IEnumerable<Promotion>

@{
    ViewData["Title"] = "Promotion List";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>

        <a asp-action="AddPromotion" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Promotion
        </a>
    </div>

    <div class="shadow p-3 mb-5 bg-white rounded">

        <table id="promotionTable"
               class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Employee</th>
                    <th>Designation From</th>
                    <th>Designation To</th>
                    <th>Promotion Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody id="promotionTableBody">

                @if (Model != null && Model.Any())
                {
                    int count = 1;

                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@count</td>

                            <td>
                                @item.User?.FirstName @item.User?.LastName
                            </td>

                            <td>
                                @item.DesignationFrom
                            </td>

                            <td>
                                @item.DesignationTo
                            </td>

                            <td>
                                @item.Date.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@item.PId"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="Delete"
                                      asp-controller="Promotion"
                                      asp-route-id="@item.PId"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this Promotion?');">

                                        <i class="bi bi-trash"></i>
                                    </button>

                                </form>
                            </td>
                        </tr>

                        count++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-secondary">

                            No promotions found.

                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
</div>