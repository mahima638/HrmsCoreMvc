@using HrmsCoreMvc.Models.Promotion
@model IEnumerable<Promotion>

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Promotion List</h3>
        <a asp-action="AddPromotion" class="btn btn-primary">Add Promotion</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Sort By</label>
            <select id="filter" class="form-select">
                <option value="all">All Records</option>
                <option value="today">Today</option>
                <option value="tomorrow">Tomorrow</option>
                <option value="last7">Last 7 Days</option>
                <option value="lastmonth">Last Month</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Sort Order</label>
            <select id="order" class="form-select">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>
    </div>

    <table id="promotionTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee</th>
                <th>From</th>
                <th>To</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.PId</td>
                    <td>@x.User.FirstName @x.User.LastName</td>
                    <td>@x.DesignationFrom</td>
                    <td>@x.DesignationTo</td>
                    <td data-order="@x.Date.ToString("yyyy-MM-dd")">@x.Date.ToString("dd-MM-yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@x.PId" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeletePromotion" asp-route-id="@x.PId" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>
<script>
    var t = $('#promotionTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[4, 'desc']] });

    $('#filter,#order').change(function() {
        var f = $('#filter').val(), o = $('#order').val();
        t.order([4, o]).draw();
        t.search('').draw();
    });

    $.fn.dataTable.ext.search.push(function(s, d) {
        var f = $('#filter').val();
        if (f == 'all') return true;

        var p = d[4].split('-'), date = new Date(p[2], p[1] - 1, p[0]), now = new Date();
        now.setHours(0, 0, 0, 0); date.setHours(0, 0, 0, 0);

        if (f == 'today') return date.getTime() == now.getTime();

        if (f == 'tomorrow') { now.setDate(now.getDate() + 1); return date.getTime() == now.getTime(); }

        if (f == 'last7') { var x = new Date(now); x.setDate(x.getDate() - 6); return date >= x && date <= now; }

        if (f == 'lastmonth') {
            var x = new Date(now.getFullYear(), now.getMonth() - 1, 1), y = new Date(now.getFullYear(), now.getMonth(), 0);
            return date >= x && date <= y;
        }
        return true;
    });
</script>