@using HrmsCoreMvc.Models.Promotion
@model IEnumerable<Promotion>

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Promotion List</h3>
        <a asp-action="AddPromotion" class="btn btn-primary">Add Promotion</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Sort By</label>
            <select id="filter" class="form-select">
                <option value="all">All Records</option>
                <option value="today">Today</option>
                <option value="tomorrow">Tomorrow</option>
                <option value="last7">Last 7 Days</option>
                <option value="lastmonth">Last Month</option>
            </select>
        </div>

        <div class="col-md-4">
            <label>Sort Order</label>
            <select id="order" class="form-select">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>
    </div>

    <table id="promotionTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th><th>Employee</th><th>From</th><th>To</th>
                <th>Date</th><th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.PId</td>
                    <td>@x.User?.FirstName @x.User?.LastName</td>
                    <td>@x.DesignationFrom</td>
                    <td>@x.DesignationTo</td>
                    <td data-order="@x.Date.ToString("yyyy-MM-dd")">
                        @x.Date.ToString("dd-MM-yyyy")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@x.PId"
                           class="btn btn-sm btn-warning">Edit</a>

                        <form asp-action="DeletePromotion"
                              asp-route-id="@x.PId"
                              method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>

<script>
    function getDate(value) {
        const p = value.split('-');
        return new Date(+p[0], +p[1] - 1, +p[2]);
    }

    $.fn.dataTable.ext.search.push(function (settings, data, index) {
        if (settings.nTable.id !== 'promotionTable') return true;

        const f = $('#filter').val();
        if (f === 'all') return true;

        const value = settings.aoData[index].anCells[4]
            .getAttribute('data-order');

        if (!value) return false;

        const date = getDate(value);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        date.setHours(0, 0, 0, 0);

        if (f === 'today')
            return date.getTime() === today.getTime();

        if (f === 'tomorrow') {
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            return date.getTime() === tomorrow.getTime();
        }

        if (f === 'last7') {
            const start = new Date(today);
            start.setDate(start.getDate() - 6);
            return date >= start && date <= today;
        }

        if (f === 'lastmonth') {
            const start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            const end = new Date(today.getFullYear(), today.getMonth(), 0);
            return date >= start && date <= end;
        }

        return true;
    });

    const table = $('#promotionTable').DataTable({
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],

        // ASC/DESC = ID
        order: [[0, 'asc']]
    });

    $('#filter').change(function () {
        table.draw();
    });

    // ASC/DESC = ID column
    $('#order').change(function () {
        table.order([0, $(this).val()]).draw();
    });
</script>