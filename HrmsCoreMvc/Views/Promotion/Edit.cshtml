@using HrmsCoreMvc.Models.Promotion
@using Microsoft.AspNetCore.Mvc.Rendering

@model Promotion

@{
    ViewData["Title"] = "Edit Promotion";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Promotion</h4>
                </div>

                <div class="card-body">

                    <form asp-controller="Promotion"
                          asp-action="UpdatePromotion"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="PId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="UserId"
                                   class="form-label">
                                Employee
                            </label>

                            <select asp-for="UserId"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Users, "UserId", "FullName", Model.UserId))">

                                <option value="">
                                    -- Select Employee --
                                </option>

                            </select>

                            <span asp-validation-for="UserId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DesignationFrom"
                                   class="form-label">
                                Designation From
                            </label>

                            <select asp-for="DesignationFrom"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Designations, "Name", "Name", Model.DesignationFrom))">

                                <option value="">
                                    -- Select Previous Designation --
                                </option>

                            </select>

                            <span asp-validation-for="DesignationFrom"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DesignationTo"
                                   class="form-label">
                                Designation To
                            </label>

                            <select asp-for="DesignationTo"
                                    class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Designations, "Name", "Name", Model.DesignationTo))">

                                <option value="">
                                    -- Select New Designation --
                                </option>

                            </select>

                            <span asp-validation-for="DesignationTo"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Date"
                                   class="form-label">
                                Promotion Date
                            </label>

                            <input asp-for="Date"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Date"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-check-circle"></i>
                                Update
                            </button>

                            <a asp-controller="Promotion"
                               asp-action="Index"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}