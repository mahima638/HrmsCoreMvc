@model HrmsCoreMvc.Models.ViewModel.DeductionViewModel


<button type="button"
        id="addDeductionBtn"
        class="btn btn-primary mb-3"
        data-bs-toggle="modal"
        data-bs-target="#exampleModal">
    Add Deduction
</button>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered table-hover" id="deductionTable">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Deduction Name</th>
            <th>Percentage</th>
            <th>Department</th>
            <th>Designation</th>
            <th width="120">Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Deductions)
        {
            <tr>

                <td>@item.DeductionId</td>
                <td>@item.DeductionType.DeductionsName</td>
                <td>@item.DeductionPercentage %</td>
                <td>@item.Department.Name</td>
                <td>@item.Designation.Name</td>

                <td>
                    <button type="button"
                    class="btn btn-primary btn-sm editBtn"
                    data-bs-toggle="modal"
                    data-bs-target="#editModal"
                    data-id="@item.DeductionId"
                    data-deductiontype="@item.DeductionTypeId"
                    data-percentage="@item.DeductionPercentage"
                    data-department="@item.DepartmentId"
                    data-designation="@item.DesignationId">
                    Edit
</button>

                    <a asp-action="DeleteDeduction"
                       asp-route-id="@item.DeductionId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this deduction?')">
                        Delete
                    </a>
</td>

            </tr>
        }

    </tbody>

</table>

<!-- Add Deduction Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Deduction</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

           <form asp-action="AddDeduction" method="post" id="addForm">

    <div class="modal-body">

        <div class="mb-3">
            <label asp-for="Deduction.DeductionTypeId" class="form-label"></label>

            <select asp-for="Deduction.DeductionTypeId"
                    asp-items="Model.DeductionList"
                    class="form-select"
                    id="addDeductionType">

                <option value="">Select Deduction</option>

            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Deduction.DeductionPercentage" class="form-label"></label>

            <input asp-for="Deduction.DeductionPercentage"
                   class="form-control"
                   id="addPercentage"/>
        </div>

        <div class="mb-3">
            <label asp-for="Deduction.DepartmentId" class="form-label"></label>

            <select asp-for="Deduction.DepartmentId"
                    asp-items="Model.DepartmentList"
                    class="form-select"
                    id="addDepartment">

                <option value="">Select Department</option>

            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Deduction.DesignationId" class="form-label"></label>

            <select asp-for="Deduction.DesignationId"
                    asp-items="Model.DesignationList"
                    class="form-select"
                    id="addDesignation">

                <option value="">Select Designation</option>

            </select>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Close
        </button>

        <button type="submit" class="btn btn-primary">
            Add Deduction
        </button>
    </div>

</form>

        </div>
    </div>
</div>

<!-- Edit Deduction Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Deduction</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form asp-action="EditDeduction" method="post">

                <div class="modal-body">

                    <input asp-for="Deduction.DeductionId"
                           type="hidden"
                           id="editId" />

                    <div class="mb-3">
                        <label>Deduction Name</label>

                        <select asp-for="Deduction.DeductionTypeId"
                                asp-items="Model.DeductionList"
                                id="editDeductionType"
                                class="form-select">

                            <option value="">Select Deduction</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Deduction Percentage</label>

                        <input asp-for="Deduction.DeductionPercentage"
                               id="editPercentage"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Department</label>

                        <select asp-for="Deduction.DepartmentId"
                                asp-items="Model.DepartmentList"
                                id="editDepartment"
                                class="form-select">

                            <option value="">Select Department</option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label>Designation</label>

                        <select asp-for="Deduction.DesignationId"
                                asp-items="Model.DesignationList"
                                id="editDesignation"
                                class="form-select">

                            <option value="">Select Designation</option>

                        </select>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Update Deduction
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts{

<script>
$(document).ready(function () {

    // DataTable
    $('#deductionTable').DataTable({
        pageLength: 10,
        lengthMenu: [5,10,25,50],
        ordering: true,
        searching: true
    });

    // ---------------- ADD BUTTON ----------------
    $('#addDeductionBtn').click(function () {

        // Clear Add Modal
        $('#addForm')[0].reset();

        $('#addDeductionType').val("");
        $('#addPercentage').val("");
        $('#addDepartment').val("");
        $('#addDesignation').val("");
    });

    // ---------------- EDIT BUTTON ----------------
    $('.editBtn').click(function () {

        $('#editId').val($(this).data('id'));
        $('#editDeductionType').val($(this).data('deductiontype'));
        $('#editPercentage').val($(this).data('percentage'));
        $('#editDepartment').val($(this).data('department'));
        $('#editDesignation').val($(this).data('designation'));

    });

});
</script>

}