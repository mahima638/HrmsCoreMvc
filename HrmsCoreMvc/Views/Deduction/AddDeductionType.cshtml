@model HrmsCoreMvc.Models.PayRoll.DeductionType


<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
    Add Deduction Type
</button>

<table class="table table-bordered table-hover" id="deductionTypeTable">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Deduction Type Name</th>
            <th width="120">Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in ViewBag.DeductionTypeList)
        {
            <tr>
                <td>@item.DeductionTypeId</td>

                <td>@item.DeductionsName</td>

                <td>
                     <button type="button"
                        class="btn btn-primary btn-sm editBtn"
                        data-bs-toggle="modal"
                        data-bs-target="#editModal"
                        data-id="@item.DeductionTypeId"
                        data-name="@item.DeductionsName">
                        Edit
                    </button>

                    <a asp-action="DeleteDeductionType"
                       asp-route-id="@item.DeductionTypeId"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this deduction type?')">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>
</table>


<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Add Earning Type</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="AddDeductionType" method="post">
            <div class="modal-body">
                <label>Deduction Name</label>
                <input type="text" asp-for="DeductionsName" class="form-control" placeholder="Enter Deduction Type Name">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Add Deduction Type</button>
            </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Deduction Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="EditDeductionType" method="post">

                <div class="modal-body">

                   
                   <input asp-for="DeductionTypeId" type="hidden" id="editId" />

                    <div class="mb-3">
                        <label>Deduction Name</label>
                        <input asp-for="DeductionsName" type="text" id="editName" class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Update
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('#deductionTypeTable').DataTable({
                pageLength: 10,
                lengthMenu: [5,10,25,50],
                ordering: true,
                searching: true
            });

            $('.editBtn').click(function () {

    var id = $(this).data('id');
    var name = $(this).data('name');

    $('#editId').val(id);
    $('#editName').val(name);

});
        });
    </script>
}
