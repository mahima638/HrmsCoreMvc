@model List<HrmsCoreMvc.Models.Role>

<h2>All Roles</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Role Id</th>
            <th>Role Name</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Created By</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.RoleId</td>
                <td>@role.RoleName</td>
                <td>@role.Status</td>
                <td>@role.CreatedAt</td>
                <td>@role.CreatedBy</td>
            </tr>
        }
    </tbody>
</table>