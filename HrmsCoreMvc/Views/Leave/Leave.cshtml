@model HrmsCoreMvc.Models.Leave.MasterLeaveType

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">




<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
    Add Leave Type
</button>


<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" asp-action="Leave">
            <div class="modal-body">
            
                    <label asp-for="LeaveType" class="form-label"></label>
                    <input type="text" asp-for="LeaveType"/>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
           </form>
        </div>
    </div>
</div>

<table id ="leaveTable" class="table table-bordered table-striped">
    <thead class="table-secondary"> 
        <tr>
            <th>Leave Type</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>   
    </thead>
    <tbody>
        @foreach (var leaveType in ViewBag.LeaveTypeList)
        {
            <tr>
                <td>@leaveType.LeaveType</td>
                <td>@leaveType.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@leaveType.LeaveTypeId" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@leaveType.LeaveTypeId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
     
</table >




<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/2.3.3/js/dataTables.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function() {

        $('#leaveTable').DataTable({
            pageLength: 10,

            lengthMenu: [5, 10, 25, 50],

            ordering: true,

            searching: true,

            paging: true,

            info: true
        });

    });
</script>