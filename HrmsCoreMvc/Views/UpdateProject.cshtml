@using HrmsCoreMvc.Models.Projects
@model AllProjects

@{
    ViewData["Title"] = "Update Project";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Update Project</h2><p class="text-muted mb-0">Update project details.</p></div><a asp-controller="Project" asp-action="GetAllProjects" class="btn btn-outline-secondary">Back to Projects</a></div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Project Information</h5></div>

        <div class="card-body">
            <form asp-controller="Project" asp-action="UpdateProject" method="post">

                <input type="hidden" asp-for="ProjectId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6"><label asp-for="ProjectName" class="form-label">Project Name</label><input asp-for="ProjectName" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="ClientName" class="form-label">Client Name</label><input asp-for="ClientName" class="form-control" /></div>

                    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>

                    <div class="col-md-6"><label asp-for="StartDate" class="form-label">Start Date</label><input asp-for="StartDate" type="date" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="EndDate" class="form-label">End Date</label><input asp-for="EndDate" type="date" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option value="">Select Priority</option><option value="High">High</option><option value="Medium">Medium</option><option value="Low">Low</option></select></div>

                    <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="">Select Status</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>

                    <div class="col-md-6"><label asp-for="ProjectValue" class="form-label">Project Value</label><input asp-for="ProjectValue" type="number" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="PriceType" class="form-label">Price Type</label><select asp-for="PriceType" class="form-select"><option value="">Select Price Type</option><option value="Fixed">Fixed</option><option value="Hourly">Hourly</option></select></div>

                    <div class="col-md-6"><label asp-for="ManagerName" class="form-label">Manager Name</label><input asp-for="ManagerName" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="LogoPath" class="form-label">Logo Path</label><input asp-for="LogoPath" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="FilePath" class="form-label">File Path</label><input asp-for="FilePath" class="form-control" /></div>

                </div>

                <div class="text-end mt-4"><a asp-controller="Project" asp-action="GetAllProjects" class="btn btn-secondary me-2">Cancel</a><button type="submit" class="btn btn-primary">Update Project</button></div>

            </form>
        </div>
    </div>
</div>