@using HrmsCoreMvc.Models.Events
@model Event

@{
    ViewData["Title"] = "Update Event";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Update Event</h2><p class="text-secondary mb-0">Update event details.</p></div><a asp-action="Holidays" class="btn btn-outline-secondary">Back to Holidays</a></div>

    <div class="card">
        <div class="card-header"><strong>Event Details</strong></div>

        <div class="card-body">

            <form asp-action="UpdateEvent" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="EventId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6"><label asp-for="Title" class="form-label">Event Title</label><input asp-for="Title" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="Date" class="form-label">Date</label><input asp-for="Date" type="date" class="form-control" /></div>

                    <div class="col-md-6">
                        <label asp-for="EventTypeId" class="form-label">Event Type</label>
                        <select asp-for="EventTypeId" class="form-select">
                            <option value="">Select Event Type</option>
                            @foreach (var type in ViewBag.EventTypes)
                            {
                                <option value="@type.EventTypeId">@type.EventTypeName</option>
                            }
                        </select>
                    </div>

                    <input type="hidden" asp-for="EventColor" />

                </div>

                <div class="text-end mt-4"><a asp-action="Holidays" class="btn btn-secondary me-2">Cancel</a><button type="submit" class="btn btn-primary">Update Event</button></div>

            </form>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>