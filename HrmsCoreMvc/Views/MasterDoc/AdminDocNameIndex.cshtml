@model IEnumerable<HrmsCoreMvc.Models.AddAdminDocName>

@{
    ViewData["Title"] = "Admin Document Name List";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Admin Document Name List</h2>

    <a asp-controller="MasterDoc"
       asp-action="AddAdminDocName"
       class="btn btn-primary">
        <i class="fa fa-plus"></i>
        Add Document
    </a>

</div>

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">
            Admin Document Name List
        </h5>
    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Document ID</th>
                    <th>Document Name</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.DocId
                        </td>

                        <td>
                            @item.AddDocName
                        </td>

                      <td>

    <a asp-controller="MasterDoc"
       asp-action="EditAdminDocName"
       asp-route-id="@item.DocId"
       class="btn btn-sm btn-primary">
        <i class="fa fa-edit"></i>
    </a>

    <a asp-controller="MasterDoc"
       asp-action="DeleteAdminDocName"
       asp-route-id="@item.DocId"
       class="btn btn-sm btn-danger">
        <i class="fa fa-trash"></i>
    </a>

</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>