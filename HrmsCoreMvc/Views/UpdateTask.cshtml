@using HrmsCoreMvc.Models.Projects
@model HrmsCoreMvc.Models.Projects.Task

@{
    ViewData["Title"] = "Update Task";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Update Task</h2><p class="text-muted mb-0">Projects > Tasks > Update Task</p></div><a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-outline-secondary">Back to Tasks</a></div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Task Information</h5></div>

        <div class="card-body">

            <form asp-controller="Task" asp-action="UpdateTask" method="post">

                <input type="hidden" asp-for="TaskId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-12"><label asp-for="Title" class="form-label">Task Title</label><input asp-for="Title" class="form-control" /></div>

                    <div class="col-md-6"><label class="form-label">Project</label><input value="@Model.Project?.ProjectName" class="form-control" readonly /><input type="hidden" asp-for="ProjectId" /></div>

                    <div class="col-md-6"><label asp-for="DueDate" class="form-label">Due Date</label><input asp-for="DueDate" type="date" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="Pending">Pending</option><option value="In Progress">In Progress</option><option value="On Hold">On Hold</option><option value="Completed">Completed</option></select></div>

                    <div class="col-md-6"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option value="High">High</option><option value="Medium">Medium</option><option value="Low">Low</option></select></div>

                    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>

                    <div class="col-12"><label asp-for="FilePath" class="form-label">Attachment</label><input asp-for="FilePath" class="form-control" /></div>

                </div>

                <div class="text-end mt-4"><a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-secondary me-2">Cancel</a><button type="submit" class="btn btn-primary">Update Task</button></div>

            </form>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>