@using HrmsCoreMvc.Models.Termination
@model IEnumerable<Termination>

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Termination List</h3>
        <a asp-action="AddTermination" class="btn btn-primary">Add Termination</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <label>Sort By</label>
            <select id="filter" class="form-select">
                <option value="all">All Records</option>
                <option value="today">Today</option>
                <option value="tomorrow">Tomorrow</option>
                <option value="last7">Last 7 Days</option>
                <option value="lastmonth">Last Month</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Sort Order</label>
            <select id="order" class="form-select">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>
    </div>

    <table id="terminationTable" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th><th>Employee Name</th><th>Termination Type</th>
                <th>Notice Date</th><th>Resign Date</th><th>Reason</th><th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TId</td>
                    <td>@item.User?.FirstName @item.User?.LastName</td>
                    <td>@item.TerminationType</td>
                    <td data-order="@item.NoticeDate.ToString("yyyy-MM-dd")">
                        @item.NoticeDate.ToString("dd-MM-yyyy")
                    </td>
                    <td data-order="@item.ResignDate.ToString("yyyy-MM-dd")">
                        @item.ResignDate.ToString("dd-MM-yyyy")
                    </td>
                    <td>@item.Reason</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.TId"
                           class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeleteTermination" asp-route-id="@item.TId"
                              method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.3/js/dataTables.min.js"></script>

<script>
const table = $('#terminationTable').DataTable({
    pageLength: 10,
    lengthMenu: [10,25,50,100],
    order: [[0,'asc']]
});

$.fn.dataTable.ext.search.push(function(settings,data) {
    if (settings.nTable.id !== 'terminationTable') return true;

    const f = $('#filter').val();
    if (f === 'all') return true;

    const p = data[4].split('-');
    if (p.length !== 3) return false;

    const d = new Date(p[2],p[1]-1,p[0]);
    const t = new Date();
    d.setHours(0,0,0,0);
    t.setHours(0,0,0,0);

    if (f === 'today')
        return d.getTime() === t.getTime();

    if (f === 'tomorrow') {
        t.setDate(t.getDate()+1);
        return d.getTime() === t.getTime();
    }

    if (f === 'last7') {
        const s = new Date(t);
        s.setDate(s.getDate()-6);
        return d >= s && d <= t;
    }

    if (f === 'lastmonth') {
        const s = new Date(t.getFullYear(),t.getMonth()-1,1);
        const e = new Date(t.getFullYear(),t.getMonth(),0);
        return d >= s && d <= e;
    }

    return true;
});

$('#filter').change(() => table.draw());

$('#order').change(function() {
    table.order([0,$(this).val()]).draw();
});
</script>