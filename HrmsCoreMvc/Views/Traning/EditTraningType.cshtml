@model HrmsCoreMvc.Models.TrainingType

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>TrainingType</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditTraningType">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TrainingTypeId" />
            <div class="form-group">
                <label asp-for="TrainingTypeName" class="control-label"></label>
                <input asp-for="TrainingTypeName" class="form-control" />
                <span asp-validation-for="TrainingTypeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<Status>()">
                    <option>Select Staus</option>
                </select>
@*                 <input asp-for="Status" class="form-control" />
 *@                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
