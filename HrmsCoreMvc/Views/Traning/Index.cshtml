@model IEnumerable<HrmsCoreMvc.Models.TrainingType>

@{
    ViewData["Title"] = "Index";
}

<h1>Training Type</h1>

<p>
    <a asp-action="AddTraningType">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrainingTypeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingTypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(model => item.TrainingTypeId)
                </td>
            <td>
                @Html.DisplayFor(model => item.TrainingTypeName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                    <a asp-action="EditTraningType" asp-route-TrainingTypeId="@item.TrainingTypeId">✏️</a> |
                    <a asp-action="DeleteTraningType" asp-route-TrainingTypeId="@item.TrainingTypeId">🗑️</a>
            </td>
        </tr>
}
    </tbody>
</table>
