@{
    ViewData["Title"] = "Training";
}

<div class="container mt-5">

    <h2 class="mb-4">Training Management</h2>

    <div class="row">

        <div class="col-md-6">
            <div class="card p-4">
                <h4>Training Types</h4>
                <p>Manage all training types.</p>

                <a asp-controller="Traning"
                   asp-action="TrainingTypeIndex"
                   class="btn btn-primary">
                    Go to Training Types
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4">
                <h4>Trainers</h4>
                <p>Manage all trainers.</p>

                <a asp-controller="Traning"
                   asp-action="TrainerIndex"
                   class="btn btn-primary">
                    Go to Trainers
                </a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-4">
                <h4>Traning</h4>
                <p>Manage all Traning.</p>

                <a asp-controller="Traning"
                   asp-action="TrainingIndex"
                   class="btn btn-primary">
                    Go to Traning
                </a>
            </div>
        </div>

    </div>

</div>