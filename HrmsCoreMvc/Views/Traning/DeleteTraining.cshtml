@model HrmsCoreMvc.Models.Training

@{
    ViewData["Title"] = "Delete Training";
}

<h3>Delete Training</h3>

<h4>Are you sure you want to delete this training?</h4>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Trainer
        </dt>
        <dd class="col-sm-9">
            @Model.Trainer?.FirstName @Model.Trainer?.LastName
        </dd>

        <dt class="col-sm-3">
            Training Type
        </dt>
        <dd class="col-sm-9">
            @Model.TrainingType?.TrainingTypeName
        </dd>

        <dt class="col-sm-3">
            Employee
        </dt>
        <dd class="col-sm-9">
            @Model.User?.FirstName @Model.User?.LastName
        </dd>

        <dt class="col-sm-3">
            Training Cost
        </dt>
        <dd class="col-sm-9">
            @Model.TrainingCost
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @(Model.Status == "1" ? "Active" : "Inactive")
        </dd>

        <dt class="col-sm-3">
            Start Date
        </dt>
        <dd class="col-sm-9">
            @Model.StartDate
        </dd>

        <dt class="col-sm-3">
            End Date
        </dt>
        <dd class="col-sm-9">
            @Model.EndDate
        </dd>

    </dl>

    <form asp-action="DeleteTraining" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="TrainingId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="TrainingIndex"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>