@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HrmsCoreMvc</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HrmsCoreMvc.styles.css"
          asp-append-version="true" />

</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <div class="bg-dark text-white"
             style="width:260px; height:100vh; position:fixed; left:0; top:0; overflow-y:auto; z-index:1000;">

            <div class="p-4 text-center border-bottom border-secondary">
                <h3 class="fw-bold mb-0">Pulse360</h3>
            </div>

            <div class="p-3">

                @if (role == "Admin")
                {
                    <ul class="nav nav-pills flex-column">

                        <!-- Dashboard -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Admin"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>


                        <!-- Employees -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminEmployeeMenu"
                               role="button">

                                <span>Employees</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminEmployeeMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Department"
                                       asp-action="getDepartment">
                                        Add Department
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Role"
                                       asp-action="getRoles">
                                        Add Role
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Designation"
                                       asp-action="GetDesignation">
                                        Add Designation
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="User"
                                       asp-action="GetEmployee">
                                        Employee List
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="EmployeeGrid"
                                       asp-action="Index">
                                        Employee Grid
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Employee"
                                       asp-action="Details">
                                        Employee Details
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Events -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminEventMenu"
                               role="button">

                                <span>Events</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminEventMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link teext-white-50 py-2"
                                       asp-controller="Event"
                                       asp-action="GetAllEvents">
                                       Add Event
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="EventType"
                                       asp-action="GetAllEventTypes">
                                        Add  Master Event
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Event"
                                       asp-action="Holidays">
                                        Event List
                                    </a>

                                   

                                </div>

                            </div>

                        </li>


                        <!-- Training -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Training
                            </a>
                        </li>


                        <!-- Master Documents -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#masterDocumentsMenu"
                               role="button">

                                <span>Master Documents</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="masterDocumentsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="MasterDoc"
                                       asp-action="AddAdminDocName">
                                        Add Admin Documents
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="MasterDoc"
                                       asp-action="AddEmpDocName">
                                        Add Emp Documents
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="MasterDoc"
                                       asp-action="AdminDocNameIndex">
                                        Admin Doc List
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="MasterDoc"
                                       asp-action="EmpDocNameIndex">
                                        Emp Doc List
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Documents -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Documents
                            </a>
                        </li>


                        <!-- Projects -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminProjectsMenu"
                               role="button">

                                <span>Projects</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminProjectsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Project"
                                       asp-action="GetAllProjects">
                                        Projects
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Task"
                                       asp-action="GetAllTasks">
                                        Tasks
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="TaskBoard"
                                       asp-action="GetAllTaskBoards">
                                        Task Board
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Reports -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminReportsMenu"
                               role="button">

                                <span>Reports</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminReportsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="EmployeeReport"
                                       asp-action="EmployeeRepView">
                                        Employee Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="AttendanceReport"
                                       asp-action="GetAttendanceReports">
                                        Attendance Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="LeaveReport"
                                       asp-action="GetLeavesReports">
                                        Leave Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="PayrollReport"
                                       asp-action="GetPayrollReports">
                                        PaySlip Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="AllProjectsReport"
                                       asp-action="GetAllProjectsReports">
                                        Project Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="TaskReport"
                                       asp-action="GetTaskreports">
                                        Task Report
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="DailyReports"
                                       asp-action="fetchDailyReports">
                                        Daily Reports
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Attendance -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
