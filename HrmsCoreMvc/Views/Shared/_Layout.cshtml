                                    </a>

                                </div>

                            </div>

                        </li>

                        <!-- Calendar -->

                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2
                                d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeCalendarMenu"
                               role="button">

                                <span>Calendar</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeCalendarMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Events
                                    </a>

                                </div>

                            </div>

                        </li>

                        <!-- Documents -->

                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2
                                d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeDocumentsMenu"
                               role="button">

                                <span>Documents</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeDocumentsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Company Letters
                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        My Documents
                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        Upload Documents
                                    </a>

                                </div>

                            </div>

                        </li>

                        <!-- Tickets -->

                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2
                                d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeTicketsMenu"
                               role="button">

                                <span>Tickets</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeTicketsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Ticket
                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        Ticket Details
                                    </a>

                                </div>

                            </div>

                        </li>

                        <!-- Logout -->

                        <li class="nav-item mt-2">
                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>

                    </ul>
                }
            </div>

        </div>


        <!--main-->

        <div style="margin-left:260px; width:100%;">

            <!-- TOP NAVBAR -->

            <nav class="navbar navbar-light bg-white border-bottom shadow-sm">

                <div class="container-fluid">

                    <span class="navbar-brand mb-0 h1">
                        HRMS
                    </span>

                    <div>

                        <span class="me-3">
                            Welcome, @role
                        </span>

                        <a class="btn btn-outline-danger"
                           asp-controller="Account"
                           asp-action="Logout">
                            Logout
                        </a>

                    </div>

                </div>

            </nav>


            <!-- PAGE CONTENT -->

            <main class="p-4">

                @RenderBody()

            </main>

        </div>

    </div>


  

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
