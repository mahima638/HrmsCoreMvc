                        </div>
                    </li>


                    <!-- Events -->
                    <li class="nav-item mb-1">

                        <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#eventMenu"
                           role="button"
                           aria-expanded="false"
                           aria-controls="eventMenu">

                            <span>Events</span>
                            <span>⌄</span>

                        </a>

                        <div class="collapse" id="eventMenu">

                            <div class="ps-3 pt-1">

                                <a class="nav-link text-white-50 py-2">
                                    Add Event
                                </a>

                                <a class="nav-link text-white-50 py-2">
                                    Add Master Event
                                </a>

                                <a class="nav-link text-white-50 py-2">
                                    Event List
                                </a>

                            </div>

                        </div>
                    </li>


                    <!-- Training -->
