
@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HrmsCoreMvc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HrmsCoreMvc.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="d-flex">

        <!-- SIDEBAR -->
        <div class="bg-dark text-white"
             style="width:260px;height:100vh;position:fixed;left:0;top:0;overflow-y:auto;z-index:1000;">

            <!-- LOGO -->
            <div class="p-4 text-center border-bottom border-secondary">
                <h3 class="fw-bold mb-0">Pulse360</h3>
            </div>

            <div class="p-3">

                @if (role == "Admin")
                {
                    <ul class="nav nav-pills flex-column">

                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Admin"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <!-- Employees -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminEmployeeMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="adminEmployeeMenu">
                                <span>Employees</span><span>⌄</span>
                            </a>

                            <div class="collapse" id="adminEmployeeMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Department"
                                       asp-action="getDepartment">
                                        Add Department
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Role"
                                       asp-action="getRoles">
                                        Add Role
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Designation"
                                       asp-action="GetDesignation">
                                        Add Designation
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="User"
                                       asp-action="GetEmployee">
                                        Employee List
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="User"
                                       asp-action="EmployeeGrid">
                                        Employee Grid
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="User"
                                       asp-action="EmployeeDetails">
                                        Employee Details
                                    </a>

                                </div>
                            </div>
                        </li>

                        <!-- Events -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Events
                            </a>
                        </li>

                        <!-- Training -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Training
                            </a>
                        </li>

                        <!-- Master Documents -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Master Documents
                            </a>
                        </li>

                        <!-- Documents -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Documents
                            </a>
                        </li>

                        <!-- Projects -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Projects
                            </a>
                        </li>

                        <!-- Reports -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Reports
                            </a>
                        </li>

                        <!-- Attendance -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Attendance
                            </a>
                        </li>

                        <!-- Payroll -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2">
                                Payroll
                            </a>
                        </li>

                        <!-- Promotion -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Promotion"
                               asp-action="Index">
                                Promotion
                            </a>
                        </li>

                        <!-- Resignation -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Resignation"
                               asp-action="Index">
                                Resignation
                            </a>
                        </li>

                        <!-- Termination -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Termination"
                               asp-action="Index">
                                Termination
                            </a>
                        </li>

                        <!-- ADMIN TICKETS -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="adminTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="adminTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        Tickets
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item mt-2">
                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>

                    </ul>
                }

                @if (role == "Manager")
                {
                    <ul class="nav nav-pills flex-column">

                        <!-- Dashboard -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Manager"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <!-- Projects -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerProjectsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="managerProjectsMenu">
                                <span>Projects</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="managerProjectsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Project</a>
                                    <a class="nav-link text-white-50 py-2">Task</a>
                                    <a class="nav-link text-white-50 py-2">Taskboard</a>

                                </div>
                            </div>
                        </li>

                        <!-- Leaves -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerLeaveMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="managerLeaveMenu">
                                <span>Leaves</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="managerLeaveMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Leave Approval</a>
                                    <a class="nav-link text-white-50 py-2">Timesheet Approval</a>
                                    <a class="nav-link text-white-50 py-2">Leave Allocation</a>

                                </div>
                            </div>
                        </li>

                        
                      <!-- Manager Tickets -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="managerTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="managerTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <!-- Assign Ticket -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="TicketAssignment"
                                       asp-action="Index">
                                        AssignTicket
                                    </a>

                                    <!-- All Ticket Details -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>

                    </ul>
                }

                @if (role == "Employee")
                {
                    <ul class="nav nav-pills flex-column">

                        <!-- Dashboard -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="User"
                               asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <!-- Employee Profile -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeProfileMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="employeeProfileMenu">
                                <span>Employees</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeProfileMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Employee"
                                       asp-action="Employee">
                                        UserProfile
                                    </a>

                                </div>
                            </div>
                        </li>

                        <!-- Attendance -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeAttendanceMenu"
                               role="button">
                                <span>Attendance</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeAttendanceMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Leave</a>
                                    <a class="nav-link text-white-50 py-2">Timesheet</a>
                                    <a class="nav-link text-white-50 py-2">Attendance (Employees)</a>

                                </div>
                            </div>
                        </li>

                        <!-- Payroll -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeePayrollMenu"
                               role="button">
                                <span>Payroll</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeePayrollMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Payslip</a>

                                </div>
                            </div>
                        </li>

                        <!-- Calendar -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeCalendarMenu"
                               role="button">
                                <span>Calendar</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeCalendarMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Events</a>

                                </div>
                            </div>
                        </li>

                        <!-- Documents -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeDocumentsMenu"
                               role="button">
                                <span>Documents</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeDocumentsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">Company Letters</a>
                                    <a class="nav-link text-white-50 py-2">My Documents</a>
                                    <a class="nav-link text-white-50 py-2">Upload Documents</a>

                                </div>
                            </div>
                        </li>

                     <!-- Employee Tickets -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="employeeTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        My Tickets
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Create">
                                        Raise Ticket
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>

                        <!-- Logout -->
                        <li class="nav-item mt-2">
                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>
                        </li>

                    </ul>
                }

            </div>
        </div>

        <!-- MAIN AREA -->
        <div style="margin-left:260px; width:100%;">

            <!-- TOP NAVBAR -->
            <nav class="navbar navbar-light bg-white border-bottom shadow-sm">
                <div class="container-fluid">

                    <span class="navbar-brand mb-0 h1">
                        HRMS
                    </span>

                    <div>
                        <span class="me-3">
                            Welcome, @role
                        </span>

                        <a class="btn btn-outline-danger"
                           asp-controller="Account"
                           asp-action="Logout">
                            Logout
                        </a>
                    </div>

                </div>
            </nav>

            <!-- PAGE CONTENT -->
            <main class="p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

