                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        Leave Allocation
                                    </a>

                                </div>

                            </div>

                        </li>

                        <!-- Tickets -->

                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2
