                               href="#adminAttendanceMenu"
                               role="button">

                                <span>Attendance</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminAttendanceMenu">

                                <div class="ps-3 pt-1">

                                    <!-- Leaves -->
                                    <a class="nav-link text-white-50 py-2 d-flex justify-content-between align-items-center"
                                       data-bs-toggle="collapse"
                                       href="#adminLeavesMenu"
                                       role="button">

                                        <span>Leaves</span>
                                        <span>⌄</span>

                                    </a>


                                    <!-- Leaves Sub Menu -->
                                    <div class="collapse" id="adminLeavesMenu">

                                        <div class="ps-3">

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="Leave">
                                                Add Leave Type
                                            </a>

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="AddLeaveDeptWise">
                                                Add Leave
                                            </a>

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="ShowDeptLeaveDetails">
                                                Department Leave Details
                                            </a>

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="LeaveSetting">
                                                Leave Setting
                                            </a>

                                        </div>

                                    </div>


                                    <!-- Attendance -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Attendance"
                                       asp-action="Index">
                                        Attendance
                                    </a>


                                    <!-- Timesheet -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Timesheet"
                                       asp-action="Timesheet">
                                        Timesheet
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Payroll -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminPayrollMenu"
                               role="button">

                                <span>Payroll</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="adminPayrollMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Earning"
                                       asp-action="AddEarning">
                                        Add Earning
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Deduction"
                                       asp-action="AddDeduction">
                                        Add Deduction
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Earning"
                                       asp-action="AddEarningType">
                                        Add Earning Type
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Deduction"
                                       asp-action="AddDeductionType">
                                        Add Deduction Type
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Promotion -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white-50 py-2"
                               asp-controller="Promotion"
                               asp-action="Index">
                                Promotions
                            </a>
                        </li>


                        <!-- Resignation -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white-50 py-2"
                               asp-controller="Resignation"
                               asp-action="Index">
                                Resignation
                            </a>
                        </li>


                        <!-- Termination -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white-50 py-2"
                               asp-controller="Termination"
                               asp-action="Index">
                                Termination
                            </a>
                        </li>


                        <!-- Tickets -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#adminTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="adminTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="adminTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        Tickets
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>


                        <!-- Logout -->
                        <li class="nav-item mt-2">

                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>

                        </li>

                    </ul>
                }


                else if (role == "Manager")
                {
                    <ul class="nav nav-pills flex-column">

                        <!-- Dashboard -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="Manager"
                               asp-action="Dashboard">
                                Dashboard
                            </a>

                        </li>


                        <!-- Projects -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerProjectsMenu"
                               role="button">

                                <span>Projects</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="managerProjectsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Project"
                                       asp-action="GetAllProjects">
                                        Projects
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Task"
                                       asp-action="GetAllTasks">
                                        Tasks
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="TaskBoard"
                                       asp-action="GetAllTaskBoards">
                                        Task Board
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Leaves -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerLeavesMenu"
                               role="button">

                                <span>Leaves</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="managerLeavesMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Leave"
                                       asp-action="ManagerLeaveRequests">
                                        Leave Approval
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Leave"
                                       asp-action="ShowDeptLeaveDetails">
                                        Leave Allocation
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Timesheet"
                                       asp-action="AdminTimesheet">
                                        Rimesheet Approval
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Tickets -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#managerTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="managerTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="managerTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <!-- Assign Ticket -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="TicketAssignment"
                                       asp-action="Index">
                                        AssignTicket
                                    </a>

                                    <!-- All Ticket Details -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>


                        <!-- Logout -->
                        <li class="nav-item mt-2">

                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>

                        </li>

                    </ul>
                }


                else if (role == "Employee")
                {
                    <ul class="nav nav-pills flex-column">

                        <!-- Dashboard -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2"
                               asp-controller="EmployeeDashboard"
                               asp-action="Dashboard">
                                Dashboard
                            </a>

                        </li>


                        <!-- Profile -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeProfileMenu"
                               role="button">

                                <span>Employees</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeProfileMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Employee"
                                       asp-action="Details">
                                        UserProfile
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Attendance -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeAttendanceMenu"
                               role="button">

                                <span>Attendance</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeAttendanceMenu">

                                <div class="ps-3 pt-1">

                                    <!-- Leaves -->
                                    <a class="nav-link text-white-50 py-2 d-flex justify-content-between align-items-center"
                                       data-bs-toggle="collapse"
                                       href="#employeeLeavesMenu"
                                       role="button">

                                        <span>Leaves</span>
                                        <span>⌄</span>

                                    </a>


                                    <!-- Leaves Sub Menu -->
                                    <div class="collapse" id="employeeLeavesMenu">

                                        <div class="ps-3">

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="ApplyLeave">
                                                Apply Leave
                                            </a>

                                            <a class="nav-link text-white-50 py-2"
                                               asp-controller="Leave"
                                               asp-action="ShowDeptLeaveDetails">
                                                Leave Details
                                            </a>

                                        </div>

                                    </div>


                                    <!-- Attendance -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Attendance"
                                       asp-action="Index">
                                        Attendance
                                    </a>


                                    <!-- Timesheet -->
                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Timesheet"
                                       asp-action="Timesheet">
                                        Timesheet
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Payroll -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeePayrollMenu"
                               role="button">

                                <span>Payroll</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeePayrollMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Payslip
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Calendar -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeCalendarMenu"
                               role="button">

                                <span>Calendar</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeCalendarMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Events
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Documents -->
                        <li class="nav-item mb-1">

                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeDocumentsMenu"
                               role="button">

                                <span>Documents</span>
                                <span>⌄</span>

                            </a>

                            <div class="collapse" id="employeeDocumentsMenu">

                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2">
                                        Company Letters
                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        My Documents
                                    </a>

                                    <a class="nav-link text-white-50 py-2">
                                        Upload Documents
                                    </a>

                                </div>

                            </div>

                        </li>


                        <!-- Tickets -->
                        <!-- Employee Tickets -->
                        <li class="nav-item mb-1">
                            <a class="nav-link text-white px-3 py-2 d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#employeeTicketsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="employeeTicketsMenu">
                                <span>Tickets</span>
                                <span>⌄</span>
                            </a>

                            <div class="collapse" id="employeeTicketsMenu">
                                <div class="ps-3 pt-1">

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Index">
                                        My Tickets
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Create">
                                        Raise Ticket
                                    </a>

                                    <a class="nav-link text-white-50 py-2"
                                       asp-controller="Ticket"
                                       asp-action="Details">
                                        Ticket Details
                                    </a>

                                </div>
                            </div>
                        </li>


                        <!-- Logout -->
                        <li class="nav-item mt-2">

                            <a class="nav-link text-danger px-3 py-2"
                               asp-controller="Account"
                               asp-action="Logout">
                                Logout
                            </a>

                        </li>

                    </ul>
                }

            </div>

        </div>


        <!-- Main Content -->
        <div style="margin-left:260px; width:100%;">

            <!-- Top Navbar -->
            <nav class="navbar navbar-light bg-white border-bottom shadow-sm">

                <div class="container-fluid">

                    <span class="navbar-brand mb-0 h1">
                        HRMS
                    </span>

                    <div>

                        <span class="me-3">
                            Welcome, @role
                        </span>

                        <a class="btn btn-outline-danger"
                           asp-controller="Account"
                           asp-action="Logout">
                            Logout
                        </a>

                    </div>

                </div>

            </nav>


            <!-- Page Content -->
            <main class="p-4">

                @RenderBody()

            </main>

        </div>

    </div>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

