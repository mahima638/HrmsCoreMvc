@model HrmsCoreMvc.Models.ViewModel.EarningViewModel

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
  Add Earning
</button>


<table class="table table-bordered table-hover" id="earningTable">

        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Earning Name</th>
                <th>Percentage</th>
                <th>Department</th>
                <th>Designation</th>
                <th width="120">Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.Earnings)
            {
                <tr>

                    <td>@item.EarningsId</td>
                    <td>@item.EarningType.EarningName</td>
                    <td>@item.EarningsPercentage</td>
                    <td>@item.Department.Name</td>
                    <td>@item.Designation.Name</td>

                    <td>
                        <a asp-action="EditEarning"
                           asp-route-id="@item.EarningsId"
                           class="btn btn-primary">
                            Edit

                        </a>

                        <a asp-action="DeleteEarning"
                           asp-route-id="@item.EarningsId"
                           class="btn btn-danger"
                           onclick="return confirm('Delete this earning?')">

                            Delete

                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form asp-action="AddEarning" method="post">

    <div class="modal-body">

        <!-- Earning Name -->
        <div class="mb-3">
            <label asp-for="Earning.EarntypeId" class="form-label">Earning Name</label>

            <select asp-for="Earning.EarntypeId"
                    asp-items="Model.EarningList"
                    class="form-control">
                <option value="">Select Earning</option>
            </select>
        </div>

        <!-- Percentage -->
        <div class="mb-3">
            <label asp-for="Earning.EarningsPercentage" class="form-label">
                Earning Percentage
            </label>

            <input asp-for="Earning.EarningsPercentage" class="form-control" />
        </div>

        <!-- Department -->
        <div class="mb-3">
            <label asp-for="Earning.DepartmentId" class="form-label">Department</label>

            <select asp-for="Earning.DepartmentId"
                    asp-items="Model.DepartmentList"
                    class="form-control">
                <option value="">Select Department</option>
            </select>
        </div>

        <!-- Designation -->
        <div class="mb-3">
            <label asp-for="Earning.DesignationId" class="form-label">Designation</label>

            <select asp-for="Earning.DesignationId"
                    asp-items="Model.DesignationList"
                    class="form-control">
                <option value="">Select Designation</option>
            </select>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Close
        </button>

        <button type="submit" class="btn btn-primary">
            Add Earning
        </button>
    </div>

</form>
    </div>
  </div>
</div>

@section Scripts {
    <script>
    $(document).ready(function () {

        $('#earningTable').DataTable({
            pageLength: 10,
            lengthMenu: [5,10,25,50],
            ordering: true,
            searching: true
        });

    });
</script>
}