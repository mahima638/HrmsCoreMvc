@model HrmsCoreMvc.Models.User

<html>
<body>

    <h2>Edit Employee</h2>

    <form asp-action="EditEmployee" method="post">

        <input type="hidden" asp-for="UserId" />

        <div>
            <label>First Name</label>
            <input type="text" asp-for="FirstName" />
        </div>

        <br />

        <div>
            <label>Last Name</label>
            <input type="text" asp-for="LastName" />
        </div>

        <br />

        <div>
            <label>Email</label>
            <input type="email" asp-for="Email" />
        </div>

        <br />

        <div>
            <label>Password</label>
            <input type="password" asp-for="PasswordHash" />
        </div>

        <br />

        <div>
            <label>Phone Number</label>
            <input type="text" asp-for="PhoneNumber" />
        </div>

        <br />

        <div>
            <label>Date of Joining</label>
            <input type="date" asp-for="DateOfJoining" />
        </div>

        <br />

        <div>
            <label>Date of Birth</label>
            <input type="date" asp-for="DateOfBirth" />
        </div>

        <br />

        <div>
            <label>Gender</label>

            <select asp-for="Gender">
                <option value="">Select Gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>

            </select>
        </div>

        <br />

        <div>
            <label>Address</label>
            <textarea asp-for="Address"></textarea>
        </div>

        <br />

        <div>
            <label>About Employee</label>
            <textarea asp-for="AboutEmployee"></textarea>
        </div>

        <br />

        <div>
            <label>Reporting Manager</label>
            <input type="text" asp-for="ReportingManager" />
        </div>

        <br />

    
        <div>
            <label>Role</label>

            <select asp-for="RoleId">
                <option value="">Select Role</option>

                @foreach (var role in ViewBag.Role)
                {
                    <option value="@role.RoleId">
                        @role.RoleName
                    </option>
                }
            </select>
        </div>

        <br />

      
        <div>
            <label>Department</label>

            <select asp-for="DepartmentId">
                <option value="">Select Department</option>

                @foreach (var dept in ViewBag.Departments)
                {
                    <option value="@dept.DepartmentId">
                        @dept.Name
                    </option>
                }
            </select>
        </div>

        <br />

      
        <div>
            <label>Designation</label>

            <select asp-for="DesignationId">
                <option value="">Select Designation</option>

                @foreach (var des in ViewBag.Designations)
                {
                    <option value="@des.DesignationId">
                        @des.Name
                    </option>
                }
            </select>
        </div>

        <br />

        <div>
            <label>Status</label>

            <select asp-for="Status">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <br />

        <input type="submit" value="Add Employee" class="btn btn-primary" />

    </form>

</body>
</html>