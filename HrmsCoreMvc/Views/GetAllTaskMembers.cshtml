@using HrmsCoreMvc.Models.Projects
@model IEnumerable<TaskMembers>
@{ ViewData["Title"] = "Task Members"; var members = Model?.OrderBy(x => x.TaskMemberName).ToList() ?? new List<TaskMembers>(); }
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css" />
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Task Members</h2><p class="text-secondary mb-0">Assign users to tasks.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#memberModal">+ Add Task Member</button></div><div class="card shadow-sm"><div class="card-header bg-white py-3"><strong>Task Member List</strong></div><div class="card-body p-3"><div class="table-responsive"><table id="membersTable" class="table table-hover align-middle w-100"><thead class="table-light"><tr><th>Member Name</th><th>Task ID</th><th>User ID</th></tr></thead><tbody>@foreach(var item in members){<tr><td class="fw-semibold">@item.TaskMemberName</td><td>@item.TaskId</td><td>@item.UserId</td></tr>}</tbody></table></div></div></div></div>
<div class="modal fade" id="memberModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="/TaskMembers/AddTaskMember">@Html.AntiForgeryToken()<input type="hidden" name="TaskMembersId" value="0" /><div class="modal-header"><h5 class="modal-title">Add Task Member</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-3"><label class="form-label">Member name</label><input class="form-control" name="TaskMemberName" required /></div><div class="mb-3"><label class="form-label">Task ID</label><input class="form-control" name="TaskId" type="number" min="1" required /></div><div class="mb-3"><label class="form-label">User ID</label><input class="form-control" name="UserId" type="number" min="1" required /></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Member</button></div></form></div></div></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script><script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script><script>new DataTable('#membersTable',{pageLength:10});</script>
