@using HrmsCoreMvc.Models.Projects
@model IEnumerable<AllProjects>

@{
    ViewData["Title"] = "Projects";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Projects</h2><div class="d-flex gap-2"><div class="dropdown position-relative"><button type="button" class="btn btn-outline-secondary" id="exportButton">Export ▼</button><ul class="dropdown-menu dropdown-menu-end" id="exportMenu" style="display:none;"><li><button type="button" class="dropdown-item" id="exportPdf">Export as PDF</button></li><li><button type="button" class="dropdown-item" id="exportExcel">Export as Excel</button></li></ul></div><a asp-controller="Project" asp-action="AddProject" class="btn btn-primary">+ Add Project</a></div></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Project List</h5></div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><label class="me-2">Show</label><select class="form-select form-select-sm d-inline-block" style="width:75px;"><option>10</option><option>25</option><option>50</option></select><span class="ms-1">entries per page</span></div>
                <div class="d-flex align-items-center"><label class="me-2">Search:</label><input type="text" id="projectSearch" class="form-control form-control-sm" style="width:180px;" placeholder="Search..." /></div>
            </div>

            <div class="table-responsive">
                <table id="projectTable" class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Project ID</th>
                            <th>Project Name</th>
                            <th>Team Members</th>
                            <th>Deadline</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProjectId</td>
                                <td>@item.ProjectName</td>
                                <td>
                                    @if (item.projectusers != null && item.projectusers.Any())
                                    {
                                        foreach (var member in item.projectusers)
                                        {
                                            <span class="badge bg-primary me-1">@member.user?.FirstName @member.user?.LastName</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No members</span>
                                    }
                                </td>
                                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Priority</td>
                                <td><span class="badge @(item.Status == "Active" ? "bg-success" : "bg-danger")">@item.Status</span></td>
                                <td><a asp-controller="Project" asp-action="UpdateProject" asp-route-projectId="@item.ProjectId" class="btn btn-sm btn-primary">Edit</a> <form asp-controller="Project" asp-action="DeleteProject" method="post" class="d-inline"><input type="hidden" name="projectId" value="@item.ProjectId" /><button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this project?')">Delete</button></form></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-muted">Showing 1 to @Model.Count() entries</span><div><button class="btn btn-sm btn-outline-secondary">Previous</button><button class="btn btn-sm btn-primary">1</button><button class="btn btn-sm btn-outline-secondary">Next</button></div></div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<script>
    $(document).ready(function () {

        $('#exportButton').on('click', function (e) {
            e.stopPropagation();
            $('#exportMenu').toggle();
        });

        $('#exportExcel').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var data = [];
            data.push([
                'Project ID',
                'Project Name',
                'Team Members',
                'Deadline',
                'Priority',
                'Status'
            ]);

            $('#projectTable tbody tr').each(function () {
                var row = $(this);

                var teamMembers = row.find('td:eq(2)').text().trim().replace(/\s+/g, ' ');

                data.push([
                    row.find('td:eq(0)').text().trim(),
                    row.find('td:eq(1)').text().trim(),
                    teamMembers,
                    row.find('td:eq(3)').text().trim(),
                    row.find('td:eq(4)').text().trim(),
                    row.find('td:eq(5)').text().trim()
                ]);
            });

            var worksheet = XLSX.utils.aoa_to_sheet(data);
            var workbook = XLSX.utils.book_new();

            XLSX.utils.book_append_sheet(workbook, worksheet, 'Projects');

            XLSX.writeFile(workbook, 'Project_List.xlsx');

            $('#exportMenu').hide();
        });

        $('#exportPdf').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var { jsPDF } = window.jspdf;
            var doc = new jsPDF('landscape', 'mm', 'a4');

            var data = [];

            $('#projectTable tbody tr').each(function () {
                var row = $(this);

                var teamMembers = row.find('td:eq(2)').text().trim().replace(/\s+/g, ' ');

                data.push([
                    row.find('td:eq(0)').text().trim(),
                    row.find('td:eq(1)').text().trim(),
                    teamMembers,
                    row.find('td:eq(3)').text().trim(),
                    row.find('td:eq(4)').text().trim(),
                    row.find('td:eq(5)').text().trim()
                ]);
            });

            doc.setFontSize(18);
            doc.text('Project List', 14, 15);

            doc.autoTable({
                head: [[
                    'Project ID',
                    'Project Name',
                    'Team Members',
                    'Deadline',
                    'Priority',
                    'Status'
                ]],
                body: data,
                startY: 22,
                theme: 'grid',
                styles: {
                    fontSize: 9
                },
                headStyles: {
                    fontSize: 9
                }
            });

            doc.save('Project_List.pdf');

            $('#exportMenu').hide();
        });

        $(document).on('click', function () {
            $('#exportMenu').hide();
        });

        $('#projectSearch').on('keyup', function () {
            var search = this.value.toLowerCase();

            $('#projectTable tbody tr').each(function () {
                $(this).toggle($(this).text().toLowerCase().includes(search));
            });
        });

    });
</script>