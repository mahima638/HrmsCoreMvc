@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<HrmsCoreMvc.Models.Reports.EmployeeReportViewModel>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .bg-orange-subtle { background-color: #fff3eb; border: 1px solid #ffe1cc; }
    .text-orange { color: #fd7e14; }
    
    .bg-green-subtle { background-color: #e6f9f0; border: 1px solid #c3f2d9; }
    .text-green { color: #20c997; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1">Employee Report</h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumnb-item"><a href="#"></a></li>
                <li class="breadcrumb-item"<a href="#">HR</a>></li>
                <li class="breadcrumb-item active">Employee Report</li>
            </ol>
        </nav>
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button"
            id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-box-arrow-up"></i> Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="exportDropdown">
            <li>
                <a class="dropdown-item" href="@Url.Action("ExportToExcel", "EmployeeReport")"><i class="bi bi-file-earmark-excel text-success me-2">
                </i>Export to Excel</a></li>
            <li>
                <a class="dropdown-item" href="@Url.Action("ExportToPdf", "EmployeeReport")">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Export to PDF
                </a>
            </li>
        </div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="row g-3">


            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-2">
                    <div class="card-body">
                       <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-orange-subtle text-orange rounded-3 p-3">
                                    <i class="bi bi-people-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Total Employee</div>
                                    <h3 class="fw-bold m-0">@ViewBag.EmpCount</h3>
                                </div>
                            </div>
                    </div>
                </div>
            </div>

             <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-2">
                    <div class="card-body">
                       <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-green-subtle text-green rounded-3 p-3">
                                    <i class="bi bi-people-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Total Department</div>
                                    <h3 class="fw-bold m-0">@ViewBag.DeptCount</h3>
                                </div>
                            </div>
                    </div>
                </div>
            </div>
             <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-2">
                    <div class="card-body">
                       <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-orange-subtle text-orange rounded-3 p-3">
                                    <i class="bi bi-people-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Active Employee</div>
                                    <h3 class="fw-bold m-0">@ViewBag.ActiveEmpCount</h3>
                                </div>
                            </div>
                    </div>
                </div>
            </div>

             <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-2">
                    <div class="card-body">
                       <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-green-subtle text-green rounded-3 p-3">
                                    <i class="bi bi-people-fill fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Roles</div>
                                    <h3 class="fw-bold m-0">@ViewBag.ActiveRoles</h3>
                                </div>
                            </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <i class="bi bi-bar-chart-line text-danger"></i>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>