@{
}

@model IEnumerable<HrmsCoreMvc.Models.Reports.DailyAttendanceViewModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .bg-orange-subtle { background-color: #fff3eb; border: 1px solid #ffe1cc; }
    .text-orange { color: #fd7e14; }
    
    .bg-green-subtle { background-color: #e6f9f0; border: 1px solid #c3f2d9; }
    .text-green { color: #20c997; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1">Daily Report</h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">HR</a></li>
                <li class="breadcrumb-item active">Daily Report</li>
            </ol>
        </nav>
    </div>

    <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-box-arrow-up"></i> Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="exportDropdown">
            <li>
                <a class="dropdown-item" href="#" id="exportCsvBtn">
                    <i class="bi bi-file-earmark-excel text-success me-2"></i>Export to Excel
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#" id="exportPdfBtn">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Export to PDF
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Main Row Containing Grid (Left 50%) and Chart (Right 50%) -->
<div class="row g-3 mb-4">

    <!-- LEFT HALF: 2x2 Metric Cards -->
    <div class="col-lg-6">
        <div class="row g-3 h-100">
            <div class="col-md-6 d-flex flex-column">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-orange-subtle text-orange rounded-3 p-3">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Total Present</div>
                                <h3 class="fw-bold m-0">@ViewBag.TotalPresent</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-green-subtle text-green rounded-3 p-3">
                                <i class="bi bi-diagram-3-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Total Absent</div>
                                <h3 class="fw-bold m-0">@ViewBag.TotalAbsent</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-blue-subtle text-blue rounded-3 p-3">
                                <i class="bi bi-person-check-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Completed Tasks</div>
                                <h3 class="fw-bold m-0">@ViewBag.CompletedTasks</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-red-subtle text-red rounded-3 p-3">
                                <i class="bi bi-shield-lock-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Pending Tasks</div>
                                <h3 class="fw-bold m-0">@ViewBag.PendingTasks</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT HALF: Chart Container Card -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-line text-danger"></i>
                        <h6 class="fw-bold mb-0">Daily Reports</h6>
                    </div>
                    <select class="form-select form-select-sm w-auto">
                        <option>This Year</option>
                        <option>Last Year</option>
                    </select>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 220px;">
                    <canvas id="dailyreportsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>



<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="get" asp-controller="DailyReports" asp-action="fetchDailyReports" id="filterForm">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold m-0">Daily Reports List</h5>
                <div class="d-flex gap-2">
                    <select name="status" class="form-select form-select-sm w-auto" onchange="document.getElementById('filterForm').submit();">
                        <option value="">All Status</option>
                        <option value="Present" selected="@(ViewBag.SelectedSortStatus == "Present")">Present</option>
                        <option value="Absent" selected="@(ViewBag.SelectedSortStatus == "Absent")">Absent</option>
                    </select>

                    <!-- Sorting Filter Dropdown -->
                    <select name="sortType" class="form-select form-select-sm w-auto" onchange="document.getElementById('filterForm').submit();">
                        <option value="">Sort By</option>
                        <option value="Ascending" selected="@(ViewBag.SelectedSortType == "Ascending")">Ascending</option>
                        <option value="Descending" selected="@(ViewBag.SelectedSortType == "Descending")">Descending</option>
                        <option value="Recently Added" selected="@(ViewBag.SelectedSortType == "Recently Added")">Recently Added</option>
                        <option value="Last Month" selected="@(ViewBag.SelectedSortType == "Last Month")">Last Month</option>
                        <option value="Last 7 days" selected="@(ViewBag.SelectedSortType == "Last 7 days")">Last 7 days</option>
                    </select>
                </div>
            </div>
        </form>
        <div class="table-responsive">
            <table id="dailyReportsTable" class="table align-middle table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Department</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dlr in Model)
                    {
                        <tr>
                            <td>@dlr.name</td>
                             <td>@dlr.Date</td>
                            <td>@dlr.Department</td>
                            <td>@dlr.Status</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>



 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
    new Chart(document.getElementById('dailyreportsChart'),{
        type:'bar',
        data:{
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels)),
            datasets: [
                               {label:'Present', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData)),backgroundColor: ['#71dd8e', '#e9ecef'],
                                borderRadius: 4}
                                         
            ]
        }
    });
</script>

 @section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#dailyReportsTable').DataTable({
                "dom": 'frtip'
            });
            $('.dropdown-toggle').dropdown();
        });

    </script>
}



<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

 <script>
     document.getElementById('exportPdfBtn').onclick = (e) => {
         e.preventDefault();
         const doc = new jspdf.jsPDF('l');
         doc.autoTable({ 
            html: '#dailyReportsTable',
            didParseCell: (d) => { if (d.column.index === 1) d.cell.text = [d.cell.raw.innerText.trim()]; }
        });
        doc.save('Daily_Report.pdf');
    };
</script>

<script>
    document.getElementById('exportCsvBtn').onclick = function(e) {
    e.preventDefault();
    const rows = document.querySelectorAll('#dailyReportsTable tr'); 
    const cvrows = Array.from(rows).map(row => {
        const cells = row.querySelectorAll('th,td');
        const cellTexts = Array.from(cells).map(cell => `"${cell.innerText.trim()}"`);
        return cellTexts.join(',');
    });

    const csvContent = cvrows.join('\n');
    const link = document.createElement('a');
    link.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvContent);
    link.download = 'Daily_Report.csv';
    link.click();
    };

</script>
     