@{
}
@model IEnumerable<HrmsCoreMvc.Models.Reports.LeavesReportViewModel>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1">Leaves Report</h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="#">HR</a></li>
                <li class="breadcrumb-item active">Leaves Report</li>
            </ol>
        </nav>
    </div>

    <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-box-arrow-up"></i> Export
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="exportDropdown">
            <li>
                <a class="dropdown-item" href="#" id="exportCsvBtn">
                    <i class="bi bi-file-earmark-excel text-success me-2"></i>Export to Excel
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="#" id="exportPdfBtn">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Export to PDF
                </a>
            </li>
        </ul>
    </div>
</div>

<div class="row g-3 mb-4">

    <!-- LEFT HALF: 2x2 Metric Cards -->
    <div class="col-lg-6">
        <div class="row g-3 h-100">
            <div class="col-md-6 d-flex flex-column">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-orange-subtle text-orange rounded-3 p-3">
                                <i class="bi bi-calendar"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Total Leaves</div>
                                <h3 class="fw-bold m-0">@ViewBag.totalLeaves</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-green-subtle text-green rounded-3 p-3">
                                <i class="bi bi-calendar"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Approved Leaves</div>
                                <h3 class="fw-bold m-0">@ViewBag.approvedLeaves</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-blue-subtle text-blue rounded-3 p-3">
                                <i class="bi bi-calendar"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Pending Requests</div>
                                <h3 class="fw-bold m-0">@ViewBag.pendingLeaves</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6  d-flex flex-column ">
                <div class="card border-0 shadow-sm h-100 p-2 flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-red-subtle text-red rounded-3 p-3">
                                <i class="bi bi-calendar"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Rejected Leaves</div>
                                <h3 class="fw-bold m-0">@ViewBag.rejectedLeaves</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT HALF: Chart Container Card -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-line text-danger"></i>
                        <h6 class="fw-bold mb-0">Paid Leaves</h6>
                    </div>
                    <select class="form-select form-select-sm w-auto">
                        <option>This Year</option>
                        <option>Last Year</option>
                    </select>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 220px;">
                    <canvas id="leavesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="get" asp-controller="LeaveReport" asp-action="GetLeavesReports" id="filterform">
             <div class="d-flex justify-content-between align-items-center mb-4">
                 <h5 class="fw-bold m-0">Leaves List</h5>
                 <div class="d-flex gap-2">
                     <select name="datefilter" class="form-select form-select-sm w-auto" onchange="document.getElementById('filterform').submit();">
                         <option value="">--Select Date Filter--</option>
                         <option value="Last 7 Days" selected="@(ViewBag.SelectedDatefilter == "Last 7 Days")">Last 7 Days</option>
                          <option value="Last 30 Days" selected="@(ViewBag.SelectedDatefilter == "Last 30 Days")">Last 30 Days</option>
                          <option value="This Year" selected="@(ViewBag.SelectedDatefilter == "This Year")">This Year</option>
                          <option value="Last Year" selected="@(ViewBag.SelectedDatefilter == "Last Year")">Last Year</option>
                          <option value="Yesterday" selected="@(ViewBag.SelectedDatefilter == "Yesterday")">Yesterday</option>
                     </select>

                      <select name="statusfilter" class="form-select form-select-sm w-auto" onchange="document.getElementById('filterform').submit();">
                         <option value="">--Select Status--</option>
                         <option value="Rejected" selected="@(ViewBag.selectedStatusfilter == "Rejected")">Rejected</option>
                          <option value="Approved" selected="@(ViewBag.selectedStatusfilter == "Approved")">Approved</option>
                          <option value="Peding" selected="@(ViewBag.selectedStatusfilter == "Pending")">Pending</option>
                     </select>

                      <select name="sortType" class="form-select form-select-sm w-auto" onchange="document.getElementById('filterform').submit();">
                         <option value="">--Select--</option>
                         <option value="Ascending" selected="@(ViewBag.selectedsortType == "Ascending")">Ascending</option>
                          <option value="Descending" selected="@(ViewBag.selectedsortType == "Descending")">Descending</option>
                          <option value="Last 7 days" selected="@(ViewBag.selectedsortType == "Last 7 days")">Last 7 days</option>
                          <option value="Last Month" selected="@(ViewBag.selectedsortType == "Last Month")">Last Month</option>
                     </select>

                 </div>
              </div>
        </form>
        <div class="table-responsive">
                <table id="leaveTable" class="table align-middle table-hover w-100">
                    <thead class="table-light">
                    <tr>
                        <th>UserId</th>
                        <th>Username</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Approved By</th>
                        <th>Status</th>
                        <th>StatusHistory</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lv in Model)
                    {
                        <tr>
                            <td>@lv.attendanceId</td>
                            <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(string.IsNullOrEmpty(lv.profilephoto) ? "/uploads/pic.jpg" : lv.profilephoto)"
                                alt="Profile"
                                class="rounded-circle object-fit-cover"
                                width="38"
                                height="38"
                                />
                                <span>@lv.userName</span>
                            </div>
                            </td>
                            <td>@lv.leaveType</td>
                            <td>@lv.StartDate</td>
                            <td>@lv.EndDate</td>
                            <td>@lv.Days</td>
                            <td>@lv.Reason</td>
                            <td>@lv.ApprovedBy</td>
                            <td>
                                @if (lv.Status == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill">Rejected</span>
                                }
                            </td>
                            <td>@lv.StatusHistory</td>
                        </tr>
                    }

                </tbody>
                </table>
            </div>
        </div>
        </div>


    
 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>
    new Chart(document.getElementById('leavesChart'),{
        type:'bar',
        data:{
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels)),
            datasets: [
                               {label:'Paid Leaves', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.paidLeaves)),backgroundColor: '#71dd8e',
                                borderRadius: 4}
                                          
            ]
        }
    });
</script>

 @section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#leaveTable').DataTable({
                "dom": 'frtip'
            });
            $('.dropdown-toggle').dropdown();
        });

    </script>
}

    
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

 <script>
     document.getElementById('exportPdfBtn').onclick = (e) => {
         e.preventDefault();
         const doc = new jspdf.jsPDF('l');
         doc.autoTable({ 
            html: '#leaveTable',
            didParseCell: (d) => { if (d.column.index === 1) d.cell.text = [d.cell.raw.innerText.trim()]; }
        });
        doc.save('Leaves_Report.pdf');
    };
</script>

<script>
    document.getElementById('exportCsvBtn').onclick = function(e) {
    e.preventDefault();
    const rows = document.querySelectorAll('#leaveTable tr'); 
    const cvrows = Array.from(rows).map(row => {
        const cells = row.querySelectorAll('th,td');
        const cellTexts = Array.from(cells).map(cell => `"${cell.innerText.trim()}"`);
        return cellTexts.join(',');
    });

    const csvContent = cvrows.join('\n');
    const link = document.createElement('a');
    link.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csvContent);
    link.download = 'Leaves_Report.csv';
    link.click();
    };

</script>
     