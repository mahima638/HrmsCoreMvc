@model HrmsCoreMvc.Models.ViewModel.AttendanceViewModel



<style>
    .attendance-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .attendance-box {
        border-right: 1px solid #e9ecef;
        padding: 20px 10px;
    }

        .attendance-box:last-child {
            border-right: none;
        }

        .attendance-box h2 {
            font-weight: 700;
            margin-top: 10px;
            margin-bottom: 10px;
        }

    .badge-present {
        background-color: #198754;
        color: white;
    }

    .badge-absent {
        background-color: #dc3545;
        color: white;
    }

    .badge-permission {
        background-color: #0d6efd;
        color: white;
    }

    .badge-late {
        background-color: #fd7e14;
        color: white;
    }

    .badge-uninformed {
        background-color: #6f42c1;
        color: white;
    }

    .table thead th {
        background-color: #f8f9fa;
        font-weight: 600;
        vertical-align: middle;
    }

    .production-badge {
        background-color: #dc3545;
        color: white;
        border-radius: 15px;
        padding: 4px 12px;
    }
</style>

<div class="container-fluid mt-3">

   
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Attendance Admin</h3>
            <small class="text-muted">Employee / Attendance Admin</small>
        </div>

        <div>
            <button class="btn btn-outline-secondary me-2">
                Export
            </button>

            <button class="btn btn-danger">
                Report
            </button>
        </div>
    </div>

   
    <div class="attendance-card mb-4">
        <div class="p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Attendance Details Today</h5>
                    <small class="text-muted">
                        Data from the @Model.TotalEmployees total employees
                    </small>
                </div>

                <div class="text-end">
                    <small class="text-muted fw-semibold">Total Absentees Today</small>
                    <h5 class="fw-bold text-danger mb-0">@Model.AbsentCount</h5>
                </div>
            </div>

            <div class="row g-0 border rounded-3 text-center">

                <div class="col attendance-box">
                    <small class="text-muted d-block">Present</small>
                    <h2>@Model.PresentCount</h2>
                    <span class="badge bg-success">+1%</span>
                </div>

             
                <div class="col attendance-box">
                    <small class="text-muted d-block">Late Login</small>
                    <h2>@Model.LateLoginCount</h2>
                    <span class="badge bg-danger">-1%</span>
                </div>

               
                <div class="col attendance-box">
                    <small class="text-muted d-block">Uninformed</small>
                    <h2>@Model.UninformedCount</h2>
                    <span class="badge bg-danger">-12%</span>
                </div>

               
                <div class="col attendance-box">
                    <small class="text-muted d-block">Permission</small>
                    <h2>@Model.PermissionCount</h2>
                    <span class="badge bg-success">+1%</span>
                </div>

              
                <div class="col attendance-box">
                    <small class="text-muted d-block">Absent</small>
                    <h2>@Model.AbsentCount</h2>
                    <span class="badge bg-danger">-19%</span>
                </div>

            </div>

        </div>
    </div>

   
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Admin Attendance</h5>

            <table id="attendanceTable" class="table table-striped table-hover table-bordered align-middle w-100">

                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Check In</th>
                        <th>Status</th>
                        <th>Check Out</th>
                        <th>Break</th>
                        <th>Late</th>
                        <th>Overtime</th>
                        <th>Production Hours</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.AttendanceHistory)
                    {
                        <tr>

                            <td>@item.Date.ToString("dd-MM-yyyy")</td>

                            <td>@item.CheckIn?.ToString("hh:mm tt")</td>

                            <td>
                                @if (item.Status == "Present")
                                {
                                    <span class="badge badge-present">Present</span>
                                }
                                else if (item.Status == "Permission")
                                {
                                    <span class="badge badge-permission">Permission</span>
                                }
                                else if (item.Status == "Late Login")
                                {
                                    <span class="badge badge-late">Late Login</span>
                                }
                                else if (item.Status == "Uninformed")
                                {
                                    <span class="badge badge-uninformed">Uninformed</span>
                                }
                                else
                                {
                                    <span class="badge badge-absent">@item.Status</span>
                                }
                            </td>

                            <td>@item.CheckOut?.ToString("hh:mm tt")</td>

                            <td>@item.BreakHours hrs</td>

                            <td>@item.Late min</td>

                            <td>@item.OvertimeHours hrs</td>

                            <td>
                                <span class="production-badge">
                                    @item.ProductionHours
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>



@section Scripts {
<script>
    $(document).ready(function () {

        $('#attendanceTable').DataTable({
            pageLength: 10,
            lengthMenu: [10, 25, 50],
            responsive: true,
            ordering: true,
            searching: true
        });

    });
</script>
}