
@model List<HrmsCoreMvc.Models.Tickets.Ticket>

<style>
    .priority {
        padding: 3px 8px;
        margin: 0;
        border-radius: 3px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
    }

    .priority.high {
        background: #dc3545;
        color: white;
    }

    .priority.medium {
        background: #ffc107;
        color: #000;
    }

    .priority.low {
        background: #198754;
        color: white;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>My Tickets</h3>
        <a asp-action="Create" class="btn btn-primary">Raise Ticket</a>
    </div>

    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-3">
                <label>Priority</label>
                <select id="priority" class="form-select">
                    <option>All</option>
                    <option>High</option>
                    <option>Medium</option>
                    <option>Low</option>
                </select>
            </div>

            <div class="col-md-3">
                <label>Status</label>
                <select id="status" class="form-select">
                    <option>All</option>
                    <option>Open</option>
                    <option>Assigned</option>
                    <option>In Progress</option>
                    <option>Resolved</option>
                    <option>Closed</option>
                    <option>Reopened</option>
                </select>
            </div>

            <div class="col-md-3">
                <label>Sort</label>
                <select id="sort" class="form-select">
                    <option value="new">Newest First</option>
                    <option value="old">Oldest First</option>
                </select>
            </div>
        </div>
    </div>

    <div id="tickets">
        @if (Model?.Any() == true)
        {
            foreach (var item in Model)
            {
                <div class="card shadow-sm mb-3 ticket"
                     data-priority="@item.Priority"
                     data-status="@item.Status"
                     data-date="@item.CreatedDate.Ticks">

                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h5>@item.Subject</h5>
                                <small class="text-muted">@item.TicketNo</small>
                            </div>
                            <div>
                                <span class="priority @(item.Priority == "High" ? "high" : item.Priority == "Medium" ? "medium" : "low")">
                                @item.Priority
                            </span>
                            </div>
                            
                        </div>

                        <hr>

                        <div class="row">
                            <div class="col-md-8">
                                <p class="text-muted">@item.Description</p>
                            <a asp-action="ViewDetails"
                               asp-route-id="@item.TicketId"
                               class="btn btn-sm btn-info text-white">
                                Details
                            </a>

                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="replyBox(@item.TicketId)">
                                    Post a Reply
                                </button>

                                <div id="replyBox_@item.TicketId"
                                     class="mt-2"
                                     style="display:none">

                                    <textarea id="reply_@item.TicketId"
                                              class="form-control mb-2"
                                              rows="2"
                                              placeholder="Write your reply..."></textarea>

                                    <button class="btn btn-sm btn-primary"
                                            onclick="sendReply(@item.TicketId)">
                                        Send Reply
                                    </button>

                                    <button class="btn btn-sm btn-secondary"
                                            onclick="replyBox(@item.TicketId)">
                                        Cancel
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <p>
                                    <b>Raised By:</b>
                                    @item.RaisedByUser?.FirstName @item.RaisedByUser?.LastName
                                </p>

                                <p>
                                    <b>Assigned To:</b>
                                    @(item.AssignedToUser == null
                                        ? "Not Assigned"
                                        : item.AssignedToUser.FirstName + " " + item.AssignedToUser.LastName)
                                </p>

                                <p>
                                    <b>Status:</b>
                                    <span class="badge bg-secondary">@item.Status</span>
                                </p>
                                @if (item.Status == "Resolved" && item.Resolution != null)
                                {
                                    <div class="alert alert-success mt-2">
                                        <b>Solution:</b>
                                        <p class="mb-0">@item.Resolution.Solution</p>
                                    </div>
                                }
                                @if (item.Status == "Resolved" && item.RaisedBy == Context.Session.GetInt32("UserId"))
                                {
                                    <div class="mt-2">
                                        <form asp-controller="Ticket"
                                              asp-action="Close"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.TicketId" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Close Ticket
                                            </button>
                                        </form>

                                        <form asp-controller="Ticket"
                                              asp-action="Reopen"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.TicketId" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                Reopen Ticket
                                            </button>
                                        </form>
                                    </div>
                                }
                                @if (item.Status == "Assigned")
                                {
                                    <form asp-controller="Ticket"
                                          asp-action="StartWork"
                                          method="post"
                                          class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.TicketId" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            Start Work
                                        </button>
                                    </form>
                                }
                                @if (item.Status == "In Progress")
                                {
                                    <form asp-controller="Ticket"
                                          asp-action="Resolve"
                                          method="post"
                                          class="mt-2">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@item.TicketId" />

                                        <textarea name="solution"
                                                  class="form-control mb-2"
                                                  rows="3"
                                                  placeholder="Enter solution..." required></textarea>

                                        <button type="submit" class="btn btn-sm btn-success">
                                            Resolve Ticket
                                        </button>
                                    </form>
                                }

                                <p class="text-muted">
                                    <b>Created:</b>
                                    @item.CreatedDate.ToString("dd-MM-yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">No tickets found.</div>
        }
    </div>
</div>

<script>
const p = document.getElementById("priority"),
      s = document.getElementById("status"),
      sort = document.getElementById("sort"),
      list = document.getElementById("tickets");

function filter() {
    let cards = [...document.querySelectorAll(".ticket")];

    cards.forEach(x => {
        x.style.display =
            (p.value == "All" || x.dataset.priority == p.value) &&
            (s.value == "All" || x.dataset.status == s.value)
                ? ""
                : "none";
    });

    cards.sort((a, b) =>
        sort.value == "new"
            ? b.dataset.date - a.dataset.date
            : a.dataset.date - b.dataset.date
    ).forEach(x => list.appendChild(x));
}

p.onchange = s.onchange = sort.onchange = filter;

function replyBox(id) {
    let x = document.getElementById("replyBox_" + id);
    x.style.display = x.style.display == "none" ? "block" : "none";
}

function sendReply(id) {
    let x = document.getElementById("reply_" + id);

    if (!x.value.trim())
        return alert("Please enter your reply.");

    alert("Reply submitted for Ticket ID: " + id);

    x.value = "";
    replyBox(id);
}

filter();
</script>

