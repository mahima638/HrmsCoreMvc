@using HrmsCoreMvc.Models.Events
@model IEnumerable<Event>

@{
    ViewData["Title"] = "Holidays";
    var holidays = Model?.OrderBy(x => x.Date).ToList() ?? new List<Event>();
    var eventTypes = ViewBag.EventTypes as IEnumerable<EventType> ?? new List<EventType>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css" />

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="mb-1">Holidays</h2><p class="text-secondary mb-0">Manage holiday dates for the organisation.</p></div>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#holidayModal">+ Add Holiday</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3"><strong>Holiday Details</strong></div>
        <div class="card-body p-3"><div class="table-responsive">
            <table id="holidaysTable" class="table table-hover align-middle w-100">
                <thead class="table-light"><tr><th>Title</th><th>Date</th><th>Event Type</th><th>Colour</th></tr></thead>
                <tbody>
                    @foreach (var item in holidays)
                    {
                        <tr><td class="fw-semibold">@item.Title</td><td>@item.Date.ToString("yyyy-MM-dd")</td><td>@(item.EventType?.EventTypeName ?? "-")</td><td><span class="badge" style="background-color:@(item.EventColor ?? "#6c757d");">@item.EventColor</span></td></tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
</div>

<div class="modal fade" id="holidayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form method="post" action="/Event/AddHoliday">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EventId" value="0" />
            <input type="hidden" name="EventColor" id="holidayColor" />
            <div class="modal-header"><h5 class="modal-title">Add Holiday</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="Title">Holiday title</label><input class="form-control" id="Title" name="Title" required maxlength="100" placeholder="e.g. Ganesh Chaturthi" /></div>
                <div class="mb-3"><label class="form-label" for="Date">Holiday date</label><input class="form-control" id="Date" name="Date" type="date" required /></div>
                <div class="mb-3">
                    <label class="form-label" for="EventTypeId">Event type</label>
                    <select class="form-select" id="EventTypeId" name="EventTypeId" required>
                        <option value="">Select event type</option>
                        @foreach (var type in eventTypes)
                        {
                            <option value="@type.EventTypeId" data-color="@type.EventTypeColor">@type.EventTypeName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Add Holiday</button></div>
        </form>
    </div></div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
<script>
    new DataTable('#holidaysTable', { pageLength: 10, language: { emptyTable: 'No holidays have been added yet.' } });
    document.getElementById('EventTypeId').addEventListener('change', function () { document.getElementById('holidayColor').value = this.options[this.selectedIndex].dataset.color || ''; });
</script>