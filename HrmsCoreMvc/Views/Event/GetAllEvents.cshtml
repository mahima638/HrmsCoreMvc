@using System.Linq
@using HrmsCoreMvc.Models.Events
@model IEnumerable<Event>

@{
    ViewData["Title"] = "Event Calendar";
    var events = Model?.ToList() ?? new List<Event>();
    var today = DateTime.Today;
    var selectedYear = int.TryParse(Context.Request.Query["year"], out var requestedYear) ? requestedYear : today.Year;
    var selectedMonth = int.TryParse(Context.Request.Query["month"], out var requestedMonth) ? requestedMonth : today.Month;
    if (selectedYear < 2000 || selectedYear > 2100) { selectedYear = today.Year; }
    if (selectedMonth < 1 || selectedMonth > 12) { selectedMonth = today.Month; }
    var calendarMonthStart = new DateTime(selectedYear, selectedMonth, 1);
    var gridStartDate = calendarMonthStart.AddDays(-(int)calendarMonthStart.DayOfWeek);
    var previousMonth = calendarMonthStart.AddMonths(-1);
    var nextMonth = calendarMonthStart.AddMonths(1);
    var eventTypes = ViewBag.EventTypes as IEnumerable<EventType> ?? new List<EventType>();
    var upcomingEvents = events.Where(x => x.Date.Date >= today).OrderBy(x => x.Date).Take(6).ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">Event Calendar</h2>
            <p class="text-secondary mb-0">View company events and holidays.</p>
        </div>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventModal">
            + Add Event
        </button>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
    <div class="card shadow-sm h-100">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <a class="btn btn-outline-secondary btn-sm" asp-action="GetAllEvents" asp-route-year="@previousMonth.Year" asp-route-month="@previousMonth.Month">&larr; Previous</a>
                <h4 class="mb-0">@calendarMonthStart.ToString("MMMM yyyy")</h4>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary btn-sm" asp-action="GetAllEvents">Today</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="GetAllEvents" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month">Next &rarr;</a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" style="min-width: 720px; table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                            {
                                <th class="text-center py-2">@dayName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var week = 0; week < 6; week++)
                        {
                            <tr>
                                @for (var day = 0; day < 7; day++)
                                {
                                    var calendarDate = gridStartDate.AddDays((week * 7) + day);
                                    var dayEvents = events.Where(x => x.Date.Date == calendarDate.Date).ToList();
                                    var isOutsideCalendarMonth = calendarDate.Month != calendarMonthStart.Month;
                                    <td class="align-top @(isOutsideCalendarMonth ? "bg-light text-secondary" : "")" style="height: 115px;">
                                        <div class="text-end small mb-2 @(calendarDate.Date == today ? "fw-bold text-primary" : "")">@calendarDate.Day</div>
                                        @foreach (var item in dayEvents)
                                        {
                                            <div class="badge text-start text-wrap w-100 mb-1" style="background-color: @(item.EventColor ?? "#6c757d");">
                                                @item.Title
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3"><strong>Upcoming Events</strong></div>
                @if (upcomingEvents.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in upcomingEvents)
                        {
                            <div class="list-group-item py-3">
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-secondary">@item.Date.ToString("yyyy-MM-dd")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card-body text-secondary">No upcoming events.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddEvent" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">Add Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="EventId" value="0" />
                    <input type="hidden" name="EventColor" id="eventColor" />

                    <div class="mb-3">
                        <label for="Title" class="form-label">Event title</label>
                        <input class="form-control" id="Title" name="Title" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="Date" class="form-label">Event date</label>
                        <input class="form-control" id="Date" name="Date" type="date" required />
                    </div>
                    <div class="mb-3">
                        <label for="EventTypeId" class="form-label">Event type</label>
                        <select class="form-select" id="EventTypeId" name="EventTypeId" required>
                            <option value="">Select event type</option>
                            @foreach (var type in eventTypes)
                            {
                                <option value="@type.EventTypeId" data-color="@type.EventTypeColor">@type.EventTypeName</option>
                            }
                        </select>
                        @if (!eventTypes.Any())
                        {
                            <div class="form-text text-danger">No event types were supplied to this view.</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // No API call: this only copies the selected type's existing values into normal MVC form fields.
    const eventTypeSelect = document.getElementById('EventTypeId');
    const setEventTypeValues = () => {
        const option = eventTypeSelect.options[eventTypeSelect.selectedIndex];
        document.getElementById('eventColor').value = option?.dataset.color || '';
    };
    eventTypeSelect.addEventListener('change', setEventTypeValues);
</script>
