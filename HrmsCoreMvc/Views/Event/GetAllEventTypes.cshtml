@using HrmsCoreMvc.Models.Events
@model IEnumerable<EventType>

@{
    ViewData["Title"] = "Event Types";
    var eventTypes = Model?.ToList() ?? new List<EventType>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="mb-1">Event Types</h2><p class="text-secondary mb-0">Create and manage event categories.</p></div>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#eventTypeModal">+ Add Event Type</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3"><strong>Existing Event Types</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th class="ps-4">Event Type</th><th>Colour</th><th>Preview</th><th class="text-end pe-4">Action</th></tr></thead>
                    <tbody>
                        @if (eventTypes.Any())
                        {
                            @foreach (var item in eventTypes)
                            {
                                <tr><td class="ps-4 fw-semibold">@item.EventTypeName</td><td><code>@item.EventTypeColor</code></td><td><span class="badge" style="background-color:@(item.EventTypeColor ?? "#6c757d");">@item.EventTypeName</span></td><td class="text-end pe-4"><a class="btn btn-sm btn-outline-danger" asp-action="DeleteEventType" asp-route-id="@item.EventTypeId">Delete</a></td></tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-secondary py-4">No event types have been added yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddEventType" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title">Add Event Type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label for="EventTypeName" class="form-label">Event type name</label><input class="form-control" id="EventTypeName" name="EventTypeName" required maxlength="100" placeholder="e.g. Holiday" /></div>
                    <div class="mb-3"><label for="EventTypeColor" class="form-label">Event colour</label><input class="form-control form-control-color" id="EventTypeColor" name="EventTypeColor" type="color" value="#0d6efd" required /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Event Type</button></div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
