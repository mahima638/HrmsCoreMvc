@using HrmsCoreMvc.Models.Projects
@model TaskBoard

@{
    ViewData["Title"] = "Update Task Board";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Update Task Board</h2><p class="text-muted mb-0">Projects > Task Board > Update Board</p></div><a asp-controller="TaskBoard" asp-action="GetAllTaskBoards" class="btn btn-outline-secondary">Back to Task Board</a></div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Task Board Information</h5></div>

        <div class="card-body">
            <form asp-controller="TaskBoard" asp-action="UpdateTaskBoard" method="post">
                <input type="hidden" asp-for="TaskBoardId" />
                <input type="hidden" asp-for="ProjectId" />
                <input type="hidden" asp-for="TaskId" />    

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6"><label class="form-label">Project Name</label><input value="@Model.Project?.ProjectName" class="form-control" readonly /></div>

                    <div class="col-md-6"><label class="form-label">Task Name</label><input value="@Model.Task?.Title" class="form-control" readonly /></div>

                    <div class="col-md-6"><label asp-for="Percentage" class="form-label">Percentage</label><input asp-for="Percentage" type="number" min="0" max="100" class="form-control" /></div>

                    <div class="col-md-6"><label asp-for="Duedate" class="form-label">Due Date</label><input asp-for="Duedate" type="date" class="form-control" /></div>

                </div>

                <div class="text-end mt-4"><a asp-controller="TaskBoard" asp-action="GetAllTaskBoards" class="btn btn-secondary me-2">Cancel</a><button type="submit" class="btn btn-primary">Update</button></div>

            </form>
        </div>
    </div>
</div>