@using HrmsCoreMvc.Models.Projects
@model HrmsCoreMvc.Models.Projects.Task

@{
    ViewData["Title"] = "Add New Task";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Add New Task</h2><p class="text-secondary mb-0">Projects &gt; Tasks &gt; Add New Task</p></div><a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-outline-secondary">Back to Tasks</a></div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Task Information</h5></div>

        <div class="card-body">

            <form asp-controller="Task" asp-action="AddTask" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12"><label asp-for="Title" class="form-label">Task Title</label><input asp-for="Title" class="form-control" placeholder="Enter task title" /><span asp-validation-for="Title" class="text-danger"></span></div>

                    <div class="col-md-6"><label asp-for="ProjectId" class="form-label">Select Project</label><select asp-for="ProjectId" class="form-select"><option value="0">Select a Project</option>@foreach (var project in ViewBag.Projects){<option value="@project.ProjectId">@project.ProjectName</option>}</select><span asp-validation-for="ProjectId" class="text-danger"></span></div>

                    <div class="col-md-6"><label asp-for="DueDate" class="form-label">Due Date</label><input asp-for="DueDate" type="date" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span></div>

                    <div class="col-md-6">
                        <label class="form-label">Team Members</label>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" id="teamMemberButton">Select Team Members</button>
                            <div class="dropdown-menu w-100 p-2">
                                @foreach (var member in ViewBag.TeamMembers)
                                {
                                    <div class="form-check"><input class="form-check-input team-member" type="checkbox" name="selectedTeamMembers" value="@member.UserId" id="member_@member.UserId" /><label class="form-check-label" for="member_@member.UserId">@member.FullName</label></div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option value="">Select Status</option><option value="Pending">Pending</option><option value="In Progress">In Progress</option><option value="On Hold">On Hold</option><option value="Completed">Completed</option></select><span asp-validation-for="Status" class="text-danger"></span></div>

                    <div class="col-md-6"><label asp-for="Priority" class="form-label">Priority</label><select asp-for="Priority" class="form-select"><option value="">Select Priority</option><option value="High">High</option><option value="Medium">Medium</option><option value="Low">Low</option></select><span asp-validation-for="Priority" class="text-danger"></span></div>

                    <div class="col-md-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter task description"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>

                    <div class="col-md-12"><label asp-for="FilePath" class="form-label">Attachment</label><input asp-for="FilePath" type="file" class="form-control" /></div>

                </div>

                <div class="text-end mt-4"><a asp-controller="Task" asp-action="GetAllTasks" class="btn btn-secondary me-2">Cancel</a><button type="submit" class="btn btn-primary">Add New Task</button></div>

            </form>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.querySelectorAll(".team-member").forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
            var selected = document.querySelectorAll(".team-member:checked").length;
            var button = document.getElementById("teamMemberButton");

            button.innerText = selected === 0 ? "Select Team Members" : selected + " members selected";
        });
    });
</script>