@model IEnumerable<HrmsCoreMvc.Models.Training>

@{
    ViewData["Title"] = "Index";
}

<h1>Training</h1>

<p>
    <a asp-action="AddTraining">Add Traning</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrainerId)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.images)
            </th>
            <th>
                Trainer
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingType)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.ProfilePicture)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrainingCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.TrainerId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.images)
                </td>
                <td>
                    @item.Trainer?.FirstName 
                </td>
                <td>
                    @item.TrainingType?.TrainingTypeName
                </td>

                <td>
                    @Html.DisplayFor(model => item.ProfilePicture)
                </td>
                <td>
                    @Html.DisplayFor(model => item.UserId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.TrainingCost)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Description)
                </td>
                <td>
                    @(item.Status == "0" ? "Active" : "Inactive")
                </td>
                <td>
                    @Html.DisplayFor(model => item.StartDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.EndDate)
                </td>
                <td>
                    <a asp-action="EditTraining" asp-route-id="@item.TrainingId">Edit</a> |
                    <a asp-action="DeleteTraining" asp-route-id="@item.TrainingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
