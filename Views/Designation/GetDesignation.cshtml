@model List<HrmsCoreMvc.Models.Designation>

<h2>All Designation</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Designation Id</th>
            <th>Designation Name</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Created By</th>

            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var des in Model)
        {
            <tr>
                <td>@des.DesignationId</td>
                <td>@des.Name</td>
                <td>@des.status</td>
                <td>@des.CreatedAt</td>
                <td>@des.CreatedBy</td>


                <td>
                    <a asp-action="EditDesignation" asp-route-id="@des.DesignationId" class="btn btn-warning">Edit</a>
                    <a asp-action="DeleteDesignation" asp-route-id="@des.DesignationId" class="btn btn-danger">Delete</a>


                </td>
            </tr>
        }
    </tbody>
</table>