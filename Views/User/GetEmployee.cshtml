@model List<HrmsCoreMvc.Models.User>

<html>
<body>

    <h2>All Users</h2>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>User Id</th>
                <th>Profile Pic</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Date Of Joining</th>
                <th>Date Of Birth</th>
                <th>Gender</th>
                <th>Address</th>
                <th>About Employee</th>
                <th>Reporting Manager</th>
                <th>Role Id</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>

                    <td>
                        <img src="@user.ProfilePicture" width="50" height="50" />
                    </td>

                    <td>@user.FirstName</td>

                    <td>@user.LastName</td>

                    <td>@user.Email</td>

                    <td>@user.PhoneNumber</td>

                    <td>@user.DateOfJoining.ToShortDateString()</td>

                    <td>@user.DateOfBirth.ToShortDateString()</td>

                    <td>@user.Gender</td>

                    <td>@user.Address</td>

                    <td>@user.AboutEmployee</td>

                    <td>@user.ReportingManager</td>

                    <td>@user.RoleId</td>

                    <td>@user.departments.Name</td>

                    <td>@user.designation.Name</td>

                    <td>@user.Status</td>

                    <td>
                        <a asp-action="EditEmployee"
                           asp-route-id="@user.UserId"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="DeleteEmployee"
                           asp-route-id="@user.UserId"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</body>
</html>