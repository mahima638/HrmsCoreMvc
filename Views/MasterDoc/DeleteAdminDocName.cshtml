@model HrmsCoreMvc.Models.AddAdminDocName

@{
    ViewData["Title"] = "Delete Admin Document Name";
}

<h4>Delete Admin Document Name</h4>
<hr />

<div class="alert alert-danger">
    Are you sure you want to delete this document?
</div>

<div>
    <strong>Document ID:</strong>
    @Model.DocId
</div>

<div>
    <strong>Document Name:</strong>
    @Model.AddDocName
</div>

<br />

<form asp-controller="MasterDoc"
      asp-action="DeleteAdminDocName"
      method="post">

    <input type="hidden"
           asp-for="DocId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="AdminDocNameIndex"
       class="btn btn-secondary">
        Cancel
    </a>

</form>