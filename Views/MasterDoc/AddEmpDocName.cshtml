@model HrmsCoreMvc.Models.AddEmpDocName

@{
    ViewData["Title"] = "Add Employee Document Name";
}

<h4>Add Employee Document Name</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-controller="MasterDoc"
              asp-action="AddEmpDocName"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">

                <label asp-for="AddDocName"
                       class="control-label">
                    Document Name
                </label>

                <input asp-for="AddDocName"
                       class="form-control"
                       placeholder="Enter Document Name" />

                <span asp-validation-for="AddDocName"
                      class="text-danger">
                </span>

            </div>

            <br />

            <div class="form-group">

                <input type="submit"
                       value="Add"
                       class="btn btn-primary" />

            </div>

        </form>

    </div>
</div>

<div>
    <a asp-controller="MasterDoc"
       asp-action="EmpDocNameIndex">
        Cancel
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}