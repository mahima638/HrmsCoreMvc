@model HrmsCoreMvc.Models.AddAdminDocName

@{
    ViewData["Title"] = "Edit Admin Document Name";
}

<h4>Edit Admin Document Name</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-controller="MasterDoc"
              asp-action="EditAdminDocName"
              method="post">

            <input type="hidden" asp-for="DocId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">

                <label asp-for="AddDocName"
                       class="control-label">
                    Document Name
                </label>

                <input asp-for="AddDocName"
                       class="form-control" />

                <span asp-validation-for="AddDocName"
                      class="text-danger">
                </span>

            </div>

            <br />

            <div class="form-group">

                <input type="submit"
                       value="Update"
                       class="btn btn-primary" />

                <a asp-action="AdminDocNameIndex"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}